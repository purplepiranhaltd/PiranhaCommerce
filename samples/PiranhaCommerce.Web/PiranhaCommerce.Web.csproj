<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Required for any host of PiranhaCommerce.Admin (Blazor Interactive Server): without it the host does not get
         _framework/blazor.web.js and admin pages never become interactive. Cannot be supplied by a NuGet package
         because it is decided at restore time. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PiranhaCommerce.Core\PiranhaCommerce.Core.csproj" />
    <ProjectReference Include="..\..\src\PiranhaCommerce.Data.SqlServer\PiranhaCommerce.Data.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\PiranhaCommerce.Data.PostgreSql\PiranhaCommerce.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\PiranhaCommerce.Api\PiranhaCommerce.Api.csproj" />
    <ProjectReference Include="..\..\src\PiranhaCommerce.Admin\PiranhaCommerce.Admin.csproj" />
    <ProjectReference Include="..\..\src\PiranhaCommerce.Ecommerce\PiranhaCommerce.Ecommerce.csproj" />
    <ProjectReference Include="..\..\src\PiranhaCommerce.Catalog\PiranhaCommerce.Catalog.csproj" />
    <ProjectReference Include="..\..\src\PiranhaCommerce.Catalog.Admin\PiranhaCommerce.Catalog.Admin.csproj" />
    <ProjectReference Include="..\..\src\PiranhaCommerce.Ecommerce.Admin\PiranhaCommerce.Ecommerce.Admin.csproj" />
    <ProjectReference Include="..\PiranhaCommerce.Example.Warranty\PiranhaCommerce.Example.Warranty.csproj" />
    <ProjectReference Include="..\PiranhaCommerce.Web.Migrations.PostgreSql\PiranhaCommerce.Web.Migrations.PostgreSql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
