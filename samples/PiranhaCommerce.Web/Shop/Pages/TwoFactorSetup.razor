@page "/account/two-factor/setup"
@using PiranhaCommerce.Admin.Services
@using PiranhaCommerce.Customers
@inject ShopSession Session
@inject NavigationManager Nav
@inject ICustomerTwoFactorService TwoFactor

<PageTitle>Set up two-factor sign-in</PageTitle>

<div class="wrap">
    <h1>Set up two-factor sign-in</h1>
    @if (_setup is null)
    {
        <p>That took too long, or the link is not valid. <a href="/account/sign-in">Please sign in again</a>.</p>
    }
    else
    {
        <p>This shop asks everyone to use a second step when they sign in. It takes a minute, and you are signed in as soon as it is done.</p>
        @if (_wrong)
        {
            <p class="error" role="alert">That code is not right. Check the app and try again.</p>
        }
        <ol>
            <li>Install an authenticator app on your phone (for example Google Authenticator, Microsoft Authenticator or Authy).</li>
            <li>Scan this picture with the app, or type in the key beside it.</li>
            <li>Type the 6-digit code the app shows.</li>
        </ol>
        <div class="qr">@((MarkupString)QrCodeSvg.Make(_setup.OtpAuthUri))</div>
        <p>Key: <code>@_setup.Secret</code></p>
        <form method="post" action="/account/two-factor/finish" class="stack">
            <AntiforgeryToken />
            <input type="hidden" name="setupToken" value="@_setupToken" />
            <input type="hidden" name="returnTo" value="@_returnTo" />
            <label>Code from your app <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" required /></label>
            <button type="submit">Turn on and sign in</button>
        </form>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "f")] private string? F { get; set; }

    private TwoFactorSetupDto? _setup;
    private string _setupToken = "";
    private string _returnTo = "/account";
    private bool _wrong;

    protected override async Task OnInitializedAsync()
    {
        // The setup token travels in the protected message that sign-in redirected here with; it lasts ten minutes and works once.
        var values = Session.Open(F)?.Values;
        if (values is null || !values.TryGetValue("setupToken", out var token)) return;
        if (await TwoFactor.CheckSetupTokenAsync(token) is not { } id) return;
        _setupToken = token;
        _returnTo = values.GetValueOrDefault("returnTo") ?? "/account";
        _wrong = values.ContainsKey("wrong");
        _setup = await TwoFactor.BeginSetupAsync(id);
    }
}
