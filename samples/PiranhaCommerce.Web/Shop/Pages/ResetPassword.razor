@page "/account/reset"

<PageTitle>Choose a new password</PageTitle>

<div class="wrap narrow">
    <h1>Choose a new password</h1>
    <FlashNotice Token="@F" />
    <form method="post" action="/account/reset" class="stack">
        <AntiforgeryToken />
        <input type="hidden" name="email" value="@Email" />
        <input type="hidden" name="token" value="@Token" />
        <p>For <strong>@Email</strong></p>
        <label>New password <input type="password" name="password" required minlength="10" autocomplete="new-password" /></label>
        <p class="muted">At least 10 characters.</p>
        <button type="submit">Change password</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "f")] private string? F { get; set; }
    [SupplyParameterFromQuery(Name = "email")] private string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "token")] private string? Token { get; set; }
}
