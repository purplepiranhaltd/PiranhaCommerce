<a class="card" href="/product/@Slug">
    <div class="card-image">
        @if (ImageUrl is not null)
        {
            <img src="@Money.Image(ImageUrl, 480)" alt="@ImageAlt" loading="lazy" width="480" height="480" />
        }
        @if (!Available) { <span class="badge out">Sold out</span> }
        else if (Sale) { <span class="badge sale">Sale</span> }
    </div>
    <h3>@Name</h3>
    @if (ReviewCount > 0)
    {
        <p class="rating"><span aria-hidden="true">@Money.Stars(ReviewAverage)</span> <span class="muted">(@ReviewCount)</span></p>
    }
    <p class="price">
        @if (From) { <span class="muted">from </span> }
        <strong>@Money.Format(Now, Currency)</strong>
        @if (Sale) { <s class="muted">@Money.Format(Was, Currency)</s> }
    </p>
    @if (Available && Left is > 0) { <p class="low">Only @Left left</p> }
</a>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string? Slug { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? ImageAlt { get; set; }
    [Parameter] public decimal Now { get; set; }
    [Parameter] public decimal Was { get; set; }
    [Parameter] public string Currency { get; set; } = "GBP";
    [Parameter] public bool From { get; set; }
    [Parameter] public bool Available { get; set; } = true;
    [Parameter] public int? Left { get; set; }
    [Parameter] public int ReviewCount { get; set; }
    [Parameter] public decimal ReviewAverage { get; set; }

    private bool Sale => Was > Now;
}
