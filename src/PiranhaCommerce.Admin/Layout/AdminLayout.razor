@inherits LayoutComponentBase

<div class="pc-shell">
    <aside class="pc-sidebar">
        <a class="pc-brand" href="/admin" aria-label="PiranhaCommerce"><img src="_content/PiranhaCommerce.Admin/logo-mark.svg" alt="" width="44" height="22" /><span><span class="w1">Piranha</span><span class="w2">Commerce</span></span></a>
        <AdminNavMenu />
        <div class="pc-user">
            <AuthorizeView>
                <Authorized>
                    <span>@context.User.Identity?.Name</span>
                    <form method="post" action="/admin/logout"><button type="submit" class="pc-link">Sign out</button></form>
                </Authorized>
            </AuthorizeView>
            <PiranhaCommerce.Admin.Components.Attribution />
        </div>
    </aside>
    <main class="pc-main">@Body</main>
</div>
