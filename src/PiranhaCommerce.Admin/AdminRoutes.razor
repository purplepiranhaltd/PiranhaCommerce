@using System.Reflection
@using Microsoft.AspNetCore.Authorization
@using PiranhaCommerce.Core.Identity
@inject IEnumerable<AdminPageAssembly> PluginPages

<Router AppAssembly="typeof(AdminApp).Assembly" AdditionalAssemblies="_pluginAssemblies">
    <Found Context="routeData">
        @if (IsAnonymous(routeData.PageType))
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.AdminLayout)" />
        }
        else
        {
            @* Secure by default: a page that names no permission is for administrators only (opt out with [AllowAnonymous]). A page names its
               permission with [Authorize(Policy = PermissionPolicies.OrdersView)] or PermissionPolicies.For("your.key"). *@
            <AuthorizeView Policy="@PolicyFor(routeData.PageType)">
                <Authorized>
                    <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.AdminLayout)" />
                </Authorized>
                <NotAuthorized Context="auth">
                    @if (auth.User.Identity?.IsAuthenticated == true)
                    {
                        <h1>Not allowed</h1>
                        <p class="pc-error">Your account does not have permission to open this page.</p>
                        <p><a href="/admin">Back to the dashboard</a></p>
                        <form method="post" action="/admin/logout"><button type="submit">Sign out</button></form>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
            </AuthorizeView>
        }
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.AdminLayout)">
            <h1>Not found</h1>
            <p>There is nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private Assembly[] _pluginAssemblies = [];

    protected override void OnInitialized() => _pluginAssemblies = PluginPages.Select(p => p.Assembly).ToArray();

    /// <summary>The policy a page asks for, or the administrators-only one when it names none.</summary>
    private static string PolicyFor(Type pageType) =>
        pageType.GetCustomAttributes<AuthorizeAttribute>(true).Select(a => a.Policy).FirstOrDefault(p => p is not null && p.StartsWith(PermissionPolicies.Prefix, StringComparison.Ordinal))
        ?? PermissionPolicies.Administrator;

    private static bool IsAnonymous(Type pageType) => pageType.GetCustomAttributes<AllowAnonymousAttribute>(true).Any();
}
