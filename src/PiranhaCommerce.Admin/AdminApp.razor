<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" /> @* an admin should never turn up in search results *@
    <base href="/" />
    <link rel="stylesheet" href="_content/PiranhaCommerce.Admin/admin.css" />
    <link rel="icon" href="_content/PiranhaCommerce.Admin/favicon.svg" type="image/svg+xml" />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>
<body>
    <AdminRoutes @rendermode="RenderModeForPage" />
    <div id="blazor-error-ui" hidden>
        An error has occurred. <a href="" class="reload">Reload</a> <a class="dismiss">x</a>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script>
        // For admin pages that offer a file: hands the browser a stream from the server as a download.
        window.piranhaDownload = async (fileName, contentType, streamReference) => {
            const blob = new Blob([await streamReference.arrayBuffer()], { type: contentType });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.href = url; link.download = fileName;
            document.body.appendChild(link); link.click(); link.remove();
            URL.revokeObjectURL(url);
        };
    </script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Pages marked [ExcludeFromInteractiveRouting] (the login page) render as static SSR so cookies can be set.
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.AcceptsInteractiveRouting() ? RenderMode.InteractiveServer : null;
}
