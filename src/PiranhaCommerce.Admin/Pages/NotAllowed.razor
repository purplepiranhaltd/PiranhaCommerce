@page "/admin/not-allowed"
@layout Layout.LoginLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PiranhaCommerce.Core.Identity
@inject AuthenticationStateProvider Auth
@inject StaffPermissionService Permissions
@inject NavigationManager Navigation

<PageTitle>Not allowed - PiranhaCommerce</PageTitle>

<div class="pc-card">
    <p class="pc-login-logo"><img src="_content/PiranhaCommerce.Admin/logo-mark.svg" alt="PiranhaCommerce" width="96" height="48" /></p>
    <h1>Not allowed</h1>
    <p class="pc-error" role="alert">Your account does not have permission to open this page.</p>
    <p>Ask an administrator to give your role the permission, or go back to somewhere you can use.</p>
    <p><a href="/admin">Back to the dashboard</a></p>
    <form method="post" action="/admin/logout"><button type="submit">Sign out</button></form>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Someone who has yet to set up compulsory two-factor sign-in is sent to do that, not left at a dead end.
        var access = await Permissions.GetAsync((await Auth.GetAuthenticationStateAsync()).User);
        if (access.TwoFactorSetupRequired) Navigation.NavigateTo("/admin/account/security", forceLoad: true);
    }
}
