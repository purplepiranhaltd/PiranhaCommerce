@page "/admin/login"
@layout Layout.LoginLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using PiranhaCommerce.Core.Identity
@inject SignInManager<PiranhaUser> SignInManager
@inject NavigationManager Navigation

<PageTitle>Sign in - Piranha Commerce</PageTitle>

<div class="pc-card">
    <h1>Sign in</h1>
    @if (_error is not null)
    {
        <p class="pc-error" role="alert">@_error</p>
    }
    <EditForm Model="Input" FormName="login" OnValidSubmit="LoginAsync" method="post">
        <DataAnnotationsValidator />
        <label>Email
            <InputText type="email" @bind-Value="Input!.Email" autocomplete="username" />
        </label>
        <ValidationMessage For="() => Input!.Email" />
        <label>Password
            <InputText type="password" @bind-Value="Input!.Password" autocomplete="current-password" />
        </label>
        <ValidationMessage For="() => Input!.Password" />
        <button type="submit">Sign in</button>
    </EditForm>
</div>

@code {
    private string? _error;

    [SupplyParameterFromForm] private LoginModel? Input { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task LoginAsync()
    {
        var user = await SignInManager.UserManager.FindByEmailAsync(Input!.Email);
        if (user is not null && user.Active)
        {
            var hadFailedAttempts = user.AccessFailedCount > 0;
            var result = await SignInManager.PasswordSignInAsync(user, Input!.Password, isPersistent: false, lockoutOnFailure: true);

            // Identity answers "Failed" to a CORRECT password when resetting the failed-attempt counter loses a concurrency race
            // against another simultaneous sign-in (an anti-guessing safeguard). That can only happen when a failed attempt is
            // already recorded. Retry, but only while the password verifies: someone who already has the right password gains
            // nothing from the retry, and wrong guesses are never retried (so they still count towards lockout exactly once).
            for (var attempt = 0; hadFailedAttempts && attempt < 3 && !result.Succeeded && !result.IsLockedOut
                                  && !result.IsNotAllowed && !result.RequiresTwoFactor; attempt++)
            {
                user = await SignInManager.UserManager.FindByEmailAsync(Input.Email);
                if (user is null || !user.Active || !await SignInManager.UserManager.CheckPasswordAsync(user, Input.Password))
                    break;
                result = await SignInManager.PasswordSignInAsync(user, Input.Password, isPersistent: false, lockoutOnFailure: true);
            }

            if (result.Succeeded)
            {
                Navigation.NavigateTo(IsLocal(ReturnUrl) ? ReturnUrl! : "/admin", forceLoad: true);
                return;
            }
            if (result.IsLockedOut)
            {
                _error = "This account is temporarily locked. Try again later.";
                return;
            }
        }
        _error = "Invalid email or password.";
    }

    // Only allow redirects back into this site (prevents open-redirect abuse of the returnUrl parameter).
    private static bool IsLocal(string? url) =>
        !string.IsNullOrEmpty(url) && url[0] == '/' && (url.Length == 1 || (url[1] != '/' && url[1] != '\\'));

    private sealed class LoginModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
        [Required] public string Password { get; set; } = "";
    }
}
