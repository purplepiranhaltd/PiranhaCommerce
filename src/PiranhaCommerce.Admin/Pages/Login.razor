@page "/admin/login"
@layout Layout.LoginLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using PiranhaCommerce.Core.Identity
@inject SignInManager<PiranhaCommerceUser> SignInManager
@inject ICredentialChecker Credentials
@inject NavigationManager Navigation

<PageTitle>Sign in - PiranhaCommerce</PageTitle>

<div class="pc-card">
    <p class="pc-login-logo"><img src="_content/PiranhaCommerce.Admin/logo-mark.svg" alt="PiranhaCommerce" width="96" height="48" /></p>
    <h1>Sign in</h1>
    @if (_error is not null)
    {
        <p class="pc-error" role="alert">@_error</p>
    }
    <EditForm Model="Input" FormName="login" OnValidSubmit="LoginAsync" method="post">
        <DataAnnotationsValidator />
        @if (_needCode)
        {
            @* Step two: the password was right. It travels in the form again so the code and the password are checked together. *@
            <InputText type="hidden" @bind-Value="Input!.Email" />
            <InputText type="hidden" @bind-Value="Input!.Password" />
            <p class="pc-muted">Enter the six-digit code from your authenticator app, or one of your recovery codes.</p>
            <label>Code
                <InputText @bind-Value="Input!.Code" autocomplete="one-time-code" inputmode="numeric" autofocus />
            </label>
        }
        else
        {
            <label>Email
                <InputText type="email" @bind-Value="Input!.Email" autocomplete="username" />
            </label>
            <ValidationMessage For="() => Input!.Email" />
            <label>Password
                <InputText type="password" @bind-Value="Input!.Password" autocomplete="current-password" />
            </label>
            <ValidationMessage For="() => Input!.Password" />
        }
        <button type="submit">@(_needCode ? "Verify" : "Sign in")</button>
    </EditForm>
</div>

@code {
    private string? _error;
    private bool _needCode;

    [SupplyParameterFromForm] private LoginModel? Input { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task LoginAsync()
    {
        var check = await Credentials.CheckAsync(Input!.Email, Input.Password, Input.Code);
        if (check.User is { } user)
        {
            await SignInManager.SignInAsync(user, isPersistent: false);
            Navigation.NavigateTo(IsLocal(ReturnUrl) ? ReturnUrl! : "/admin", forceLoad: true);
            return;
        }
        if (check.Status == CredentialStatus.TwoFactorRequired) { _needCode = true; Input.Code = null; return; }
        if (check.Status == CredentialStatus.TwoFactorInvalid) { _needCode = true; Input.Code = null; _error = "That code is not right. Try again."; return; }
        _error = check.Status == CredentialStatus.LockedOut
            ? "This account is temporarily locked. Try again later."
            : "Invalid email or password.";
    }

    // Only allow redirects back into this site (prevents open-redirect abuse of the returnUrl parameter).
    private static bool IsLocal(string? url) =>
        !string.IsNullOrEmpty(url) && url[0] == '/' && (url.Length == 1 || (url[1] != '/' && url[1] != '\\'));

    private sealed class LoginModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
        [Required] public string Password { get; set; } = "";
        public string? Code { get; set; }
    }
}
