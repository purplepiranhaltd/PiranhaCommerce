@page "/admin/catalog/stock-transfers"
@using PiranhaCommerce.Core.Paging
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminScopeRunner Scope
@inject AuthenticationStateProvider Auth

<PageTitle>Stock transfers - PiranhaCommerce</PageTitle>
<h1>Stock transfers</h1>
<p class="pc-muted">
    Stock moved between locations. One person sends it (it leaves that location straight away) and someone else receives it at the other end.
    Until then it is in transit: on neither shelf, but listed here. If less arrives than was sent, say so when receiving and the transfer is flagged.
</p>

@if (_error is not null)
{
    <p class="pc-error" role="alert">@_error</p>
}
@if (_message is not null)
{
    <p role="status">@_message</p>
}

<div class="pc-card">
    <h2 style="margin-top:0">Send stock</h2>
    <div class="pc-toolbar">
        <select aria-label="From location" @bind="_from">
            <option value="@Guid.Empty">From...</option>
            @foreach (var l in _locations.Where(l => l.Active)) { <option value="@l.Id">@l.Code - @l.Name</option> }
        </select>
        <select aria-label="To location" @bind="_to">
            <option value="@Guid.Empty">To...</option>
            @foreach (var l in _locations.Where(l => l.Active)) { <option value="@l.Id">@l.Code - @l.Name</option> }
        </select>
        <input aria-label="Note" placeholder="Note (optional)" @bind="_note" style="min-width:14rem" />
    </div>
    <div class="pc-toolbar">
        <input aria-label="Find a product" placeholder="Find a product by name or SKU" @bind="_search" @bind:event="oninput" @onkeydown="SearchKey" style="min-width:16rem" />
        <button class="secondary" @onclick="SearchAsync">Find</button>
    </div>
    @if (_found.Count > 0)
    {
        <ul class="pc-list">
            @foreach (var p in _found)
            {
                <li><button class="secondary" @onclick="() => AddLine(p)">Add</button> @p.Name <span class="pc-muted">@p.Sku</span></li>
            }
        </ul>
    }
    @if (_lines.Count > 0)
    {
        <table class="pc-table">
            <thead><tr><th>Product</th><th style="width:9rem">Quantity</th><th></th></tr></thead>
            <tbody>
            @foreach (var l in _lines)
            {
                <tr>
                    <td>@l.Name <span class="pc-muted">@l.Sku</span></td>
                    <td><input type="number" step="any" aria-label="Quantity of @l.Name" @bind="l.Quantity" /></td>
                    <td class="actions"><button class="secondary" @onclick="() => _lines.Remove(l)">Remove</button></td>
                </tr>
            }
            </tbody>
        </table>
        <button @onclick="SendAsync" disabled="@_busy">Send transfer</button>
    }
</div>

<div class="pc-toolbar">
    <label>Show
        <select @bind="_filter" @bind:after="LoadAsync">
            <option value="transit">In transit</option>
            <option value="discrepancies">Received with a difference</option>
            <option value="all">Everything</option>
        </select>
    </label>
</div>

@if (_items is null)
{
    <p class="pc-muted">Loading...</p>
}
else if (_items.Items.Count == 0)
{
    <p class="pc-muted">Nothing to show.</p>
}
else
{
    @foreach (var t in _items.Items)
    {
        <div class="pc-card">
            <h3 style="margin-top:0">@t.Reference: @t.FromCode to @t.ToCode
                <span class="pc-muted">(@t.Status@(t.HasDiscrepancy ? ", difference flagged" : ""))</span></h3>
            <p class="pc-muted">Sent @t.SentUtc.ToString("dd MMM yyyy HH:mm") by @(t.SentBy ?? "unknown")
                @if (t.ReceivedUtc is { } r) { <text>. Received @r.ToString("dd MMM yyyy HH:mm") by @(t.ReceivedBy ?? "unknown")</text> }
                @if (t.CancelledUtc is { } c) { <text>. Cancelled @c.ToString("dd MMM yyyy HH:mm") by @(t.CancelledBy ?? "unknown")</text> }
                @if (!string.IsNullOrEmpty(t.Note)) { <text>. @t.Note</text> }
            </p>
            <table class="pc-table">
                <thead><tr><th>Product</th><th style="text-align:right">Sent</th><th style="text-align:right">@(t.Status == StockTransferStatus.InTransit ? "Received" : "Received")</th></tr></thead>
                <tbody>
                @foreach (var l in t.Lines)
                {
                    <tr>
                        <td>@l.ProductName <span class="pc-muted">@l.Sku</span></td>
                        <td style="text-align:right">@l.QuantitySent.ToString("0.####")</td>
                        <td style="text-align:right">
                            @if (t.Status == StockTransferStatus.InTransit)
                            {
                                <input type="number" step="any" style="width:7rem" aria-label="Received of @l.ProductName"
                                       value="@Received(t, l).ToString("0.####")" @onchange="e => SetReceived(t, l, e.Value)" />
                            }
                            else
                            {
                                @(l.QuantityReceived?.ToString("0.####") ?? "-")
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            @if (t.Status == StockTransferStatus.InTransit)
            {
                <div class="pc-toolbar">
                    <button @onclick="() => ReceiveAsync(t)" disabled="@_busy">Receive</button>
                    <button class="secondary" @onclick="() => CancelAsync(t)" disabled="@_busy">Cancel transfer</button>
                </div>
            }
        </div>
    }
}

@code {
    private sealed class Line { public Guid ProductId; public string Name = ""; public string? Sku; public decimal Quantity = 1; }

    private List<StockLocationDto> _locations = [];
    private PagedResult<StockTransferDto>? _items;
    private readonly List<Line> _lines = [];
    private List<ProductDto> _found = [];
    private readonly Dictionary<(Guid, Guid), decimal> _received = [];
    private Guid _from, _to;
    private string? _note, _search, _error, _message;
    private string _filter = "transit";
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try { _locations = (await Scope.RunAsync<IStockLocationService, IReadOnlyList<StockLocationDto>>(s => s.ListAsync())).ToList(); }
        catch (Exception ex) { _error = "Could not load locations: " + ex.Message; }
        await LoadAsync();
    }

    private decimal Received(StockTransferDto t, StockTransferLineDto l) => _received.TryGetValue((t.Id, l.ProductId), out var q) ? q : l.QuantitySent;

    private void SetReceived(StockTransferDto t, StockTransferLineDto l, object? value)
    {
        if (decimal.TryParse(value?.ToString(), out var q)) _received[(t.Id, l.ProductId)] = q;
    }

    private async Task LoadAsync()
    {
        try
        {
            StockTransferStatus? status = _filter == "transit" ? StockTransferStatus.InTransit : null;
            bool? diff = _filter == "discrepancies" ? true : null;
            _items = await Scope.RunAsync<IStockTransferService, PagedResult<StockTransferDto>>(s => s.ListAsync(1, 100, status, null, diff));
        }
        catch (Exception ex) { _error = "Could not load transfers: " + ex.Message; }
    }

    private async Task SearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") await SearchAsync(); }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_search)) { _found = []; return; }
        try { _found = (await Scope.RunAsync<IProductService, PagedResult<ProductDto>>(s => s.ListAsync(1, 8, _search))).Items.ToList(); }
        catch (Exception ex) { _error = "Could not search: " + ex.Message; }
    }

    private void AddLine(ProductDto p)
    {
        if (_lines.All(l => l.ProductId != p.Id)) _lines.Add(new Line { ProductId = p.Id, Name = p.Name, Sku = p.Sku });
        _found = []; _search = null;
    }

    private async Task<StockActor> ActorAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        var id = user.FindFirst("sub")?.Value ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return new StockActor(Guid.TryParse(id, out var g) ? g : null, await Auth.GetActorAsync());
    }

    private async Task RunAsync(Func<Task> action, string done)
    {
        _busy = true; _error = null; _message = null;
        try { await action(); _message ??= done; await LoadAsync(); }
        catch (PiranhaValidationException ex) { _error = string.Join(" ", ex.Errors.SelectMany(x => x.Value)); }
        catch (PiranhaConflictException ex) { _error = ex.Message; }
        catch (PiranhaForbiddenException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = "That did not work: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task SendAsync()
    {
        var actor = await ActorAsync();
        var input = new StockTransferInput
        {
            FromLocationId = _from, ToLocationId = _to, Note = _note,
            Lines = _lines.Select(l => new StockTransferLineInput { ProductId = l.ProductId, Quantity = l.Quantity }).ToList(),
        };
        await RunAsync(async () =>
        {
            var sent = await Scope.RunAsync<IStockTransferService, StockTransferDto>(s => s.SendAsync(input, actor));
            _message = $"{sent.Reference} sent.";
            _lines.Clear(); _note = null;
        }, "Sent.");
    }

    private async Task ReceiveAsync(StockTransferDto t)
    {
        var actor = await ActorAsync();
        var input = new StockTransferReceiveInput
        {
            Lines = t.Lines.Select(l => new StockTransferLineInput { ProductId = l.ProductId, Quantity = Received(t, l) }).ToList(),
        };
        await RunAsync(async () => { await Scope.RunAsync<IStockTransferService, StockTransferDto?>(s => s.ReceiveAsync(t.Id, input, actor)); }, $"{t.Reference} received.");
    }

    private async Task CancelAsync(StockTransferDto t)
    {
        var actor = await ActorAsync();
        await RunAsync(async () => { await Scope.RunAsync<IStockTransferService, StockTransferDto?>(s => s.CancelAsync(t.Id, actor)); }, $"{t.Reference} cancelled; the stock is back at {t.FromCode}.");
    }
}
