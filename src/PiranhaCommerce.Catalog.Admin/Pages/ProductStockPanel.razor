@* Panel for AdminSlots.ProductEditPanels. Adjustments are applied immediately and recorded in the stock ledger. *@
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminScopeRunner Scope

<div class="pc-card" style="margin-top:1rem">
    <h2 style="margin-top:0">Stock</h2>
    @if (_loading)
    {
        <p class="pc-muted">Loading...</p>
    }
    else
    {
        <p>
            On hand: <strong data-testid="stock-quantity">@_quantity.ToString("0.####")</strong>
            @if (_quantity < 0 || _perLocation.Any(l => l.Quantity < 0))
            {
                <span class="pc-error" role="alert"> Below zero: a recount is needed.</span>
            }
        </p>
        @if (_locations.Count > 1)
        {
            <ul class="pc-muted">
                @foreach (var l in _perLocation)
                {
                    <li>@l.LocationName (@l.LocationCode): @l.Quantity.ToString("0.####")</li>
                }
            </ul>
        }
        <div class="pc-toolbar">
            @if (_locations.Count > 1)
            {
                <select aria-label="Stock location" @bind="_locationId">
                    @foreach (var l in _locations)
                    {
                        <option value="@l.Id">@l.Name (@l.Code)</option>
                    }
                </select>
            }
            <input type="number" step="0.0001" aria-label="Change in quantity (negative to remove)" placeholder="+/- quantity" style="width:9rem" @bind="_delta" />
            <input aria-label="Reason" placeholder="Reason (e.g. Delivery, Stocktake)" @bind="_reason" />
            <input aria-label="Reference" placeholder="Reference (optional)" @bind="_reference" />
            <PiranhaCommerce.Admin.Components.Can Permission="stock.adjust"><button type="button" @onclick="AdjustAsync" disabled="@_saving">Apply</button></PiranhaCommerce.Admin.Components.Can>
        </div>
        @if (_message is not null)
        {
            <p class="@(_failed ? "pc-error" : "pc-muted")" role="status">@_message</p>
        }
        @if (_movements.Count > 0)
        {
            <table class="pc-table">
                <thead><tr><th>When (UTC)</th>@if (_locations.Count > 1){<th>Location</th>}<th class="num">Change</th><th class="num">Balance</th><th>Reason</th><th>Reference</th><th>By</th></tr></thead>
                <tbody>
                @foreach (var m in _movements)
                {
                    <tr>
                        <td>@m.CreatedUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        @if (_locations.Count > 1){<td>@(_locations.FirstOrDefault(l => l.Id == m.LocationId)?.Code)</td>}
                        <td class="num">@m.Delta.ToString("+0.####;-0.####")</td>
                        <td class="num">@(m.Balance?.ToString("0.####") ?? "")</td>
                        <td>@m.Reason</td>
                        <td>@m.Reference</td>
                        <td>@m.Actor</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid ProductId { get; set; }
    [Inject] private AuthenticationStateProvider Auth { get; set; } = default!;

    private decimal _quantity, _delta;
    private string _reason = "", _reference = "";
    private Guid _locationId = StockLocations.DefaultId;
    private List<StockLocationDto> _locations = [];
    private IReadOnlyList<StockLocationLevelDto> _perLocation = [];
    private List<StockMovementDto> _movements = [];
    private bool _loading = true, _saving, _failed;
    private string? _message;
    private Guid _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ProductId) return;
        _loadedFor = ProductId;
        _loading = true;
        _message = null;
        var all = await Scope.RunAsync<IStockLocationService, IReadOnlyList<StockLocationDto>>(s => s.ListAsync());
        _locations = all.Where(l => l.Active).ToList();
        if (_locations.All(l => l.Id != _locationId)) _locationId = _locations.FirstOrDefault()?.Id ?? StockLocations.DefaultId;
        await RefreshAsync();
        _loading = false;
    }

    private async Task RefreshAsync()
    {
        var level = await Scope.RunAsync<IStockService, StockLevelDto?>(s => s.GetLevelAsync(ProductId));
        _quantity = level?.Quantity ?? 0;
        _perLocation = level?.Locations ?? [];
        var page = await Scope.RunAsync<IStockService, PiranhaCommerce.Core.Paging.PagedResult<StockMovementDto>?>(s => s.ListMovementsAsync(ProductId, 1, 10));
        _movements = page?.Items.ToList() ?? [];
    }

    private async Task AdjustAsync()
    {
        _saving = true;
        _failed = false;
        try
        {
            var state = await Auth.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name;
            var input = new StockAdjustmentInput { Delta = _delta, Reason = _reason, Reference = _reference, LocationId = _locationId };
            var r = await Scope.RunAsync<IStockService, StockAdjustmentResult?>(s => s.AdjustAsync(ProductId, input, actor));
            if (r is null) { _failed = true; _message = "Product no longer exists."; }
            else
            {
                _message = "Stock updated.";
                _delta = 0; _reason = ""; _reference = "";
                await RefreshAsync();
            }
        }
        catch (PiranhaCommerceValidationException ex) { _failed = true; _message = string.Join(" ", ex.Errors.SelectMany(e => e.Value)); }
        catch (PiranhaCommerceConflictException ex) { _failed = true; _message = ex.Message; }
        catch (Exception ex) { _failed = true; _message = "Could not adjust stock: " + ex.Message; }
        finally { _saving = false; }
    }
}
