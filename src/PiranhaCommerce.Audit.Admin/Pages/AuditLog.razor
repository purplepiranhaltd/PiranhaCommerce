@page "/admin/audit"
@inject AdminScopeRunner Scope

<PageTitle>Audit log - PiranhaCommerce</PageTitle>
<h1>Audit log</h1>
<p class="pc-muted">Who created, changed or deleted products, categories, orders, prices, promotions, tax, shipping, customers and so on, newest first.
    Personal details (names, emails, addresses, notes) are recorded as "changed" without their values.</p>

<div class="pc-toolbar">
    <label>What <input type="text" placeholder="Product, Order, Promotion..." style="width:12rem" @bind="_entityType" /></label>
    <label>Id <input type="text" style="width:18rem" @bind="_entityId" /></label>
    <label>Who <input type="text" placeholder="email" style="width:14rem" @bind="_actor" /></label>
    <label>From <input type="date" @bind="_from" /></label>
    <label>To <input type="date" @bind="_to" /></label>
    <button type="button" disabled="@_busy" @onclick="SearchAsync">Show</button>
</div>

@if (_error is not null)
{
    <p class="pc-error" role="alert">@_error</p>
}
@if (_result is null)
{
    <p class="pc-muted">Loading...</p>
}
else if (_result.Items.Count == 0)
{
    <p data-testid="no-audit">Nothing recorded for that.</p>
}
else
{
    <table class="pc-table">
        <thead><tr><th>When (UTC)</th><th>Who</th><th>What</th><th>Changes</th></tr></thead>
        <tbody>
        @foreach (var e in _result.Items)
        {
            <tr>
                <td>@e.WhenUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@(e.Actor ?? "(system)")</td>
                <td>@e.Action @e.EntityType <strong>@e.Label</strong><br /><small class="pc-muted">@e.EntityId</small></td>
                <td>
                    @foreach (var c in e.Changes.Take(12))
                    {
                        <div>
                            <strong>@c.Property</strong>:
                            @if (c.Hidden) { <em>changed</em> }
                            else if (e.Action == AuditAction.Created) { <span>@c.To</span> }
                            else if (e.Action == AuditAction.Deleted) { <span>@c.From</span> }
                            else { <span>@(c.From ?? "(empty)") &rarr; @(c.To ?? "(empty)")</span> }
                        </div>
                    }
                    @if (e.Changes.Count > 12) { <small class="pc-muted">and @(e.Changes.Count - 12) more</small> }
                </td>
            </tr>
        }
        </tbody>
    </table>
    <p>
        <button type="button" class="secondary" disabled="@(_busy || _page <= 1)" @onclick="() => GoAsync(_page - 1)">Previous</button>
        Page @_result.Page of @Math.Max(_result.TotalPages, 1) (@_result.TotalCount entries)
        <button type="button" class="secondary" disabled="@(_busy || _page >= _result.TotalPages)" @onclick="() => GoAsync(_page + 1)">Next</button>
    </p>
}

@code {
    private string? _entityType, _entityId, _actor;
    private DateTime? _from, _to;
    private int _page = 1;
    private bool _busy;
    private string? _error;
    private PiranhaCommerce.Core.Paging.PagedResult<AuditEntryDto>? _result;

    protected override Task OnInitializedAsync() => SearchAsync();

    private Task SearchAsync() => GoAsync(1);

    private async Task GoAsync(int page)
    {
        _busy = true; _error = null;
        try
        {
            var (type, id, actor, from, to) = (_entityType, _entityId, _actor, _from is { } f ? DateOnly.FromDateTime(f) : (DateOnly?)null, _to is { } t ? DateOnly.FromDateTime(t) : (DateOnly?)null);
            _result = await Scope.RunAsync<IAuditService, PiranhaCommerce.Core.Paging.PagedResult<AuditEntryDto>>(s => s.ListAsync(page, 25, type, id, actor, from, to));
            _page = page;
        }
        catch (PiranhaCommerceValidationException ex) { _error = string.Join(" ", ex.Errors.SelectMany(e => e.Value)); _result ??= new([], 1, 25, 0); }
        catch (Exception ex) { _error = "Could not load the log: " + ex.Message; _result ??= new([], 1, 25, 0); }
        finally { _busy = false; }
    }
}
