@page "/admin/orders/shipping"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = PiranhaCommerce.Core.Identity.PermissionPolicies.Access)]
@inject AdminScopeRunner Scope

<PageTitle>Shipping methods - PiranhaCommerce</PageTitle>
<h1>Shipping methods</h1>
<p class="pc-muted">Once any method is active, checkout must choose one. With none, shipping is free. Orders keep their own copy of the name and price. A method can charge by destination and basket weight: edit it, then add rates below.</p>

@if (_error is not null)
{
    <p class="pc-error" role="alert">@_error</p>
}

<div class="pc-card">
    <EditForm Model="_input" OnValidSubmit="SaveAsync" FormName="shipping-edit">
        <DataAnnotationsValidator />
        <h2 style="margin-top:0">@(_editing is null ? "Add a method" : "Edit method")</h2>
        <label>Name <InputText @bind-Value="_input.Name" /></label>
        <ValidationMessage For="() => _input.Name" />
        <label>Price <InputNumber @bind-Value="_input.Price" /></label>
        <label>Free when the basket reaches (optional) <InputNumber @bind-Value="_input.FreeOver" /></label>
        <label>Order in the list <InputNumber @bind-Value="_input.Position" /></label>
        <label><InputCheckbox @bind-Value="_input.Active" /> Active</label>
        <PiranhaCommerce.Admin.Components.Can Permission="settings.manage"><button type="submit" disabled="@_busy">Save</button></PiranhaCommerce.Admin.Components.Can>
        @if (_editing is not null)
        {
            <button type="button" class="secondary" @onclick="Reset">Cancel</button>
        }
    </EditForm>
</div>

@if (_editing is not null)
{
    <div class="pc-card">
        <h2 style="margin-top:0">Rates for this method</h2>
        <p class="pc-muted">
            With no rates, the price above applies everywhere. With rates, a destination or weight no row covers is not served by this method.
            Each row is a country (or * for every other country) or a shipping zone, and a weight band in grams: from the first weight up to, but not including, the second
            (leave it empty for no limit). Rows for a country you list take precedence over the * rows. A method uses countries or zones, not both; a method priced by zone is
            offered only to the zones it has rows for. The "free when the basket reaches" amount still applies. Set a product's weight in its Online store settings.
            Zones and carriers are set up under Shipping zones and Shipping carriers.
        </p>
        <table class="pc-table">
            <thead><tr><th>Country</th><th>or zone</th><th>From (g)</th><th>Up to (g)</th><th>Price</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in _rates)
            {
                <tr>
                    <td><InputText @bind-Value="r.CountryCode" maxlength="2" style="width:4rem" disabled="@(r.ZoneId is not null)" /></td>
                    <td>
                        <InputSelect TValue="Guid?" Value="r.ZoneId" ValueChanged="(Guid? z) => ChooseZone(r, z)" ValueExpression="() => r.ZoneId">
                            <option value="">None (use the country)</option>
                            @foreach (var z in _zones) { <option value="@z.Id">@z.Name</option> }
                        </InputSelect>
                    </td>
                    <td><InputNumber @bind-Value="r.MinWeightGrams" /></td>
                    <td><InputNumber @bind-Value="r.MaxWeightGrams" /></td>
                    <td><InputNumber @bind-Value="r.Price" /></td>
                    <td class="actions"><PiranhaCommerce.Admin.Components.Can Permission="settings.manage"><button type="button" class="secondary" @onclick="() => _rates.Remove(r)">Remove</button></PiranhaCommerce.Admin.Components.Can></td>
                </tr>
            }
            </tbody>
        </table>
        <PiranhaCommerce.Admin.Components.Can Permission="settings.manage"><button type="button" class="secondary" @onclick="AddRate">Add a rate</button></PiranhaCommerce.Admin.Components.Can>
        <PiranhaCommerce.Admin.Components.Can Permission="settings.manage"><button type="button" disabled="@_busy" @onclick="SaveRatesAsync">Save rates</button></PiranhaCommerce.Admin.Components.Can>
        @if (_ratesMessage is not null)
        {
            <span class="pc-muted" role="status"> @_ratesMessage</span>
        }
    </div>
}

@if (_methods is null)
{
    <p class="pc-muted">Loading...</p>
}
else if (_methods.Count == 0)
{
    <p class="pc-muted">No shipping methods: shipping is free.</p>
}
else
{
    <table class="pc-table">
        <thead><tr><th>Name</th><th style="text-align:right">Price</th><th style="text-align:right">Free over</th><th>Rates</th><th>Active</th><th></th></tr></thead>
        <tbody>
        @foreach (var m in _methods)
        {
            <tr>
                <td>@m.Name</td>
                <td style="text-align:right">@m.Price.ToString("N2")</td>
                <td style="text-align:right">@(m.FreeOver?.ToString("N2") ?? "-")</td>
                <td>@(m.RateCount == 0 ? "flat price" : m.RateCount + " rates")</td>
                <td>@(m.Active ? "Yes" : "No")</td>
                <td class="actions">
                    <PiranhaCommerce.Admin.Components.Can Permission="settings.manage"><button class="secondary" @onclick="() => EditAsync(m)">Edit</button></PiranhaCommerce.Admin.Components.Can>
                    @if (_confirmDelete == m.Id)
                    {
                        <PiranhaCommerce.Admin.Components.Can Permission="settings.manage"><button class="danger" @onclick="() => DeleteAsync(m.Id)">Confirm delete</button></PiranhaCommerce.Admin.Components.Can>
                        <button class="secondary" @onclick="() => _confirmDelete = null">Cancel</button>
                    }
                    else
                    {
                        <PiranhaCommerce.Admin.Components.Can Permission="settings.manage"><button class="secondary" @onclick="() => _confirmDelete = m.Id">Delete</button></PiranhaCommerce.Admin.Components.Can>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<ShippingMethodDto>? _methods;
    private ShippingMethodInput _input = new();
    private Guid? _editing;
    private List<ShippingRateInput> _rates = [];
    private IReadOnlyList<ShippingZoneDto> _zones = [];
    private string? _ratesMessage;
    private Guid? _confirmDelete;
    private string? _error;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _methods = await Scope.RunAsync<IShippingService, IReadOnlyList<ShippingMethodDto>>(s => s.ListAsync(false));
            _zones = await Scope.RunAsync<IShippingZoneService, IReadOnlyList<ShippingZoneDto>>(s => s.ListAsync());
        }
        catch (Exception ex) { _error = "Could not load shipping methods: " + ex.Message; }
    }

    private async Task EditAsync(ShippingMethodDto m)
    {
        _editing = m.Id;
        _ratesMessage = null;
        _input = new ShippingMethodInput { Name = m.Name, Price = m.Price, FreeOver = m.FreeOver, Active = m.Active, Position = m.Position };
        var id = m.Id;
        var rates = await Scope.RunAsync<IShippingService, IReadOnlyList<ShippingRateDto>?>(s => s.GetRatesAsync(id));
        _rates = (rates ?? []).Select(r => new ShippingRateInput { CountryCode = r.ZoneId is null ? r.CountryCode : null, ZoneId = r.ZoneId, MinWeightGrams = r.MinWeightGrams, MaxWeightGrams = r.MaxWeightGrams, Price = r.Price }).ToList();
    }

    private void Reset() { _editing = null; _input = new(); _rates = []; _ratesMessage = null; }

    private void AddRate() => _rates.Add(_rates.Any(r => r.ZoneId is not null) && _zones.Count > 0 ? new ShippingRateInput { ZoneId = _zones[0].Id } : new ShippingRateInput { CountryCode = "*" });

    private void ChooseZone(ShippingRateInput rate, Guid? zone) { rate.ZoneId = zone; rate.CountryCode = zone is null ? "*" : null; }

    private async Task SaveRatesAsync()
    {
        if (_editing is not { } id) return;
        _busy = true; _error = null; _ratesMessage = null;
        try
        {
            var input = new ShippingRatesInput { Rates = _rates };
            var saved = await Scope.RunAsync<IShippingService, IReadOnlyList<ShippingRateDto>?>(s => s.SetRatesAsync(id, input));
            _ratesMessage = saved is null ? "That method no longer exists." : "Saved.";
        }
        catch (PiranhaCommerceValidationException ex) { _error = string.Join(" ", ex.Errors.SelectMany(e => e.Value)); }
        catch (Exception ex) { _error = "Could not save the rates: " + ex.Message; }
        finally { _busy = false; }
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        _busy = true; _error = null;
        try
        {
            if (_editing is { } id) await Scope.RunAsync<IShippingService, ShippingMethodDto?>(s => s.UpdateAsync(id, _input));
            else await Scope.RunAsync<IShippingService, ShippingMethodDto>(s => s.CreateAsync(_input));
            Reset();
        }
        catch (PiranhaCommerceValidationException ex) { _error = string.Join(" ", ex.Errors.SelectMany(e => e.Value)); }
        catch (Exception ex) { _error = "Could not save: " + ex.Message; }
        finally { _busy = false; }
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        _confirmDelete = null; _error = null;
        try { await Scope.RunAsync<IShippingService, bool>(s => s.DeleteAsync(id)); }
        catch (Exception ex) { _error = "Could not delete: " + ex.Message; }
        await LoadAsync();
    }
}
