@page "/admin/orders/{Id:guid}"
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminScopeRunner Scope
@inject AuthenticationStateProvider Auth

<PageTitle>@(_order?.Reference ?? "Order") - Piranha Commerce</PageTitle>

@if (_notFound)
{
    <h1>Order</h1>
    <p class="pc-error">That order no longer exists. <a href="/admin/orders">Back to orders</a></p>
}
else if (_order is null)
{
    <h1>Order</h1>
    <p class="pc-muted">Loading...</p>
}
else
{
    <h1>Order @_order.Reference</h1>

    @if (_error is not null)
    {
        <p class="pc-error" role="alert">@_error</p>
    }

    <div class="pc-card">
        <p>
            <strong>@_order.Stage</strong> &middot; placed @_order.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC
            &middot; <a href="mailto:@_order.Email">@_order.Email</a>
            @if (_order.CustomerId is { } customerId)
            {
                <text> &middot; <a href="/admin/customers/@customerId">customer record</a></text>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(_order.Notes))
        {
            <p><em>Note from the buyer:</em> @_order.Notes</p>
        }

        @if (_order.NextStages.Count > 0)
        {
            <div class="pc-toolbar">
                @foreach (var next in _order.NextStages)
                {
                    @if (next == OrderStage.Cancelled)
                    {
                        @if (_confirmCancel)
                        {
                            <button class="danger" disabled="@_busy" @onclick="() => MoveAsync(next)">Confirm: cancel and return stock</button>
                            <button class="secondary" @onclick="() => _confirmCancel = false">Keep order</button>
                        }
                        else
                        {
                            <button class="secondary" disabled="@_busy" @onclick="() => _confirmCancel = true">Cancel order</button>
                        }
                    }
                    else
                    {
                        <button disabled="@_busy" @onclick="() => MoveAsync(next)">Mark as @next.ToString().ToLowerInvariant()</button>
                    }
                }
            </div>
        }
        else
        {
            <p class="pc-muted">This order is @_order.Stage.ToString().ToLowerInvariant() and can no longer change.</p>
        }
    </div>

    <div class="pc-card">
        <h2 style="margin-top:0">Items</h2>
        <table class="pc-table">
            <thead>
                <tr><th>Product</th><th>SKU</th><th style="text-align:right">Price</th><th style="text-align:right">Qty</th><th style="text-align:right">Total</th></tr>
            </thead>
            <tbody>
            @foreach (var l in _order.Lines)
            {
                <tr>
                    <td><a href="/admin/products/@l.ProductId">@l.Name</a></td>
                    <td>@l.Sku</td>
                    <td style="text-align:right">@l.UnitPrice.ToString("N2")</td>
                    <td style="text-align:right">@l.Quantity</td>
                    <td style="text-align:right">@l.LineTotal.ToString("N2")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr><td colspan="4" style="text-align:right">Subtotal</td><td style="text-align:right">@_order.Subtotal.ToString("N2")</td></tr>
                <tr><td colspan="4" style="text-align:right">Shipping@(string.IsNullOrEmpty(_order.ShippingMethodName) ? "" : " (" + _order.ShippingMethodName + ")")</td><td style="text-align:right">@_order.ShippingTotal.ToString("N2")</td></tr>
                @if (_order.Taxes is { Count: > 0 })
                {
                    @foreach (var t in _order.Taxes)
                    {
                        <tr><td colspan="4" style="text-align:right">@t.Name (@t.Rate.ToString("0.####")%)</td><td style="text-align:right">@t.Amount.ToString("N2")</td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" style="text-align:right">Tax</td><td style="text-align:right">@_order.TaxTotal.ToString("N2")</td></tr>
                }
                <tr><th colspan="4" style="text-align:right">Total (@_order.Currency)</th><th style="text-align:right">@_order.Total.ToString("N2")</th></tr>
            </tfoot>
        </table>
        <p class="pc-muted">Names and prices are copies taken when the order was placed.</p>
    </div>

    <div class="pc-card">
        <h2 style="margin-top:0">Payment: @_order.PaymentStatus</h2>
        <p>Paid @_order.AmountPaid.ToString("N2") @_order.Currency, refunded @_order.AmountRefunded.ToString("N2"), of @_order.Total.ToString("N2").</p>
        @if (_order.Stage == OrderStage.Cancelled && _order.AmountPaid - _order.AmountRefunded > 0)
        {
            <p class="pc-error">This order is cancelled but @((_order.AmountPaid - _order.AmountRefunded).ToString("N2")) has not been refunded.</p>
        }
        @if (_payments is { Count: > 0 })
        {
            <table class="pc-table">
                <thead><tr><th>When</th><th>Type</th><th>Provider</th><th>Reference</th><th>By</th><th style="text-align:right">Amount</th></tr></thead>
                <tbody>
                @foreach (var p in _payments)
                {
                    <tr>
                        <td>@p.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</td>
                        <td>@p.Kind</td>
                        <td>@p.Provider</td>
                        <td>@p.Reference @(string.IsNullOrWhiteSpace(p.Note) ? "" : "(" + p.Note + ")")</td>
                        <td>@p.Actor</td>
                        <td style="text-align:right">@(p.Kind == PaymentKind.Refund ? "-" : "")@p.Amount.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        <EditForm Model="_payment" OnValidSubmit="() => RecordAsync(false)" FormName="payment">
            <DataAnnotationsValidator />
            <label>Amount <InputNumber @bind-Value="_payment.Amount" /></label>
            <ValidationMessage For="() => _payment.Amount" />
            <label>Provider
                <InputSelect @bind-Value="_payment.Provider">
                    @foreach (var provider in _providers)
                    {
                        <option value="@provider.Name">@provider.DisplayName</option>
                    }
                </InputSelect>
            </label>
            <label>Reference (receipt or bank reference, optional) <InputText @bind-Value="_payment.Reference" /></label>
            <label>Note (optional) <InputText @bind-Value="_payment.Note" /></label>
            <button type="submit" disabled="@_busy">Record payment</button>
            <button type="button" class="secondary" disabled="@_busy" @onclick="() => RecordAsync(true)">Record refund</button>
        </EditForm>
    </div>

    <div class="pc-card">
        <h2 style="margin-top:0">Addresses</h2>
        <div style="display:flex; gap:2rem; flex-wrap:wrap">
            <AddressBlock Title="Ship to" Address="_order.ShippingAddress" />
            <AddressBlock Title="Billing" Address="_order.BillingAddress" />
        </div>
    </div>

    <p><a href="/admin/orders">Back to orders</a></p>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private OrderDto? _order;
    private bool _notFound;
    private bool _busy;
    private bool _confirmCancel;
    private string? _error;
    private IReadOnlyList<PaymentDto>? _payments;
    private IReadOnlyList<PaymentProviderDto> _providers = [];
    private PaymentInput _payment = new() { Provider = "manual" };

    protected override async Task OnParametersSetAsync()
    {
        _order = await Scope.RunAsync<IOrderService, OrderDto?>(s => s.GetAsync(Id));
        _notFound = _order is null;
        if (_order is not null) await LoadPaymentsAsync();
    }

    private async Task LoadPaymentsAsync()
    {
        _payments = await Scope.RunAsync<IPaymentService, IReadOnlyList<PaymentDto>?>(s => s.ListAsync(Id));
        _providers = await Scope.RunAsync<IPaymentService, IReadOnlyList<PaymentProviderDto>>(s => Task.FromResult(s.Providers()));
        var owed = _order!.Total - (_order.AmountPaid - _order.AmountRefunded);
        _payment = new PaymentInput { Provider = _payment.Provider ?? "manual", Amount = owed > 0 && _order.Stage != OrderStage.Cancelled ? owed : 0 };
    }

    private async Task RecordAsync(bool refund)
    {
        _busy = true;
        _error = null;
        try
        {
            var state = await Auth.GetAuthenticationStateAsync();
            var actor = state.User.FindFirst("email")?.Value ?? state.User.Identity?.Name;
            var input = _payment;
            if (refund) await Scope.RunAsync<IPaymentService, PaymentDto?>(s => s.RecordRefundAsync(Id, input, actor));
            else await Scope.RunAsync<IPaymentService, PaymentDto?>(s => s.RecordPaymentAsync(Id, input, actor));
            _order = await Scope.RunAsync<IOrderService, OrderDto?>(s => s.GetAsync(Id)) ?? _order;
            await LoadPaymentsAsync();
        }
        catch (PiranhaValidationException ex) { _error = string.Join(" ", ex.Errors.SelectMany(e => e.Value)); }
        catch (PiranhaConflictException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = "Could not record that: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task MoveAsync(OrderStage to)
    {
        _busy = true;
        _error = null;
        _confirmCancel = false;
        try
        {
            var state = await Auth.GetAuthenticationStateAsync();
            var actor = state.User.FindFirst("email")?.Value ?? state.User.Identity?.Name;
            var updated = await Scope.RunAsync<IOrderService, OrderDto?>(s => s.ChangeStageAsync(Id, to, actor));
            if (updated is null) _notFound = true; else { _order = updated; await LoadPaymentsAsync(); }
        }
        catch (PiranhaConflictException ex)
        {
            _error = ex.Message;
            _order = await Scope.RunAsync<IOrderService, OrderDto?>(s => s.GetAsync(Id)) ?? _order; // show what it is now
        }
        catch (Exception ex)
        {
            _error = "Could not update the order: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
