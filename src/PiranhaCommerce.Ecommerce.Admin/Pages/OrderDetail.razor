@page "/admin/orders/{Id:guid}"
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminScopeRunner Scope
@inject AuthenticationStateProvider Auth

<PageTitle>@(_order?.Reference ?? "Order") - PiranhaCommerce</PageTitle>

@if (_notFound)
{
    <h1>Order</h1>
    <p class="pc-error">That order no longer exists. <a href="/admin/orders">Back to orders</a></p>
}
else if (_order is null)
{
    <h1>Order</h1>
    <p class="pc-muted">Loading...</p>
}
else
{
    <h1>Order @_order.Reference</h1>

    @if (_error is not null)
    {
        <p class="pc-error" role="alert">@_error</p>
    }

    <div class="pc-card">
        <p>
            <strong>@_order.Stage</strong> &middot; placed @_order.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC
            &middot; <a href="mailto:@_order.Email">@_order.Email</a>
            @if (_order.CustomerId is { } customerId)
            {
                <text> &middot; <a href="/admin/customers/@customerId">customer record</a></text>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(_order.Notes))
        {
            <p><em>Note from the buyer:</em> @_order.Notes</p>
        }

        @if (_order.NextStages.Count > 0)
        {
            <div class="pc-toolbar">
                @foreach (var next in _order.NextStages)
                {
                    @if (next == OrderStage.Cancelled)
                    {
                        @if (_confirmCancel)
                        {
                            <button class="danger" disabled="@_busy" @onclick="() => MoveAsync(next)">Confirm: cancel and return stock</button>
                            <button class="secondary" @onclick="() => _confirmCancel = false">Keep order</button>
                        }
                        else
                        {
                            <button class="secondary" disabled="@_busy" @onclick="() => _confirmCancel = true">Cancel order</button>
                        }
                    }
                    else
                    {
                        <button disabled="@_busy" @onclick="() => MoveAsync(next)">Mark as @next.ToString().ToLowerInvariant()</button>
                    }
                }
            </div>
        }
        else
        {
            <p class="pc-muted">This order is @_order.Stage.ToString().ToLowerInvariant() and can no longer change.</p>
        }
    </div>

    <div class="pc-card">
        <h2 style="margin-top:0">Items</h2>
        <table class="pc-table">
            <thead>
                <tr><th>Product</th><th>SKU</th><th style="text-align:right">Price</th><th style="text-align:right">Qty</th><th style="text-align:right">Total</th></tr>
            </thead>
            <tbody>
            @foreach (var l in _order.Lines)
            {
                <tr>
                    <td><a href="/admin/products/@l.ProductId">@l.Name</a></td>
                    <td>@l.Sku</td>
                    <td style="text-align:right">@l.UnitPrice.ToString("N2")</td>
                    <td style="text-align:right">@l.Quantity</td>
                    <td style="text-align:right">@l.LineTotal.ToString("N2")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr><td colspan="4" style="text-align:right">Subtotal</td><td style="text-align:right">@_order.Subtotal.ToString("N2")</td></tr>
                @if (_order.DiscountTotal > 0)
                {
                    <tr><td colspan="4" style="text-align:right">Discount@(string.IsNullOrEmpty(_order.PromotionCode) ? "" : " (" + _order.PromotionCode + ")")</td><td style="text-align:right">-@_order.DiscountTotal.ToString("N2")</td></tr>
                }
                <tr><td colspan="4" style="text-align:right">Shipping@(string.IsNullOrEmpty(_order.ShippingMethodName) ? "" : " (" + _order.ShippingMethodName + ")")</td><td style="text-align:right">@_order.ShippingTotal.ToString("N2")</td></tr>
                @if (_order.Taxes is { Count: > 0 })
                {
                    @foreach (var t in _order.Taxes)
                    {
                        <tr><td colspan="4" style="text-align:right">@t.Name (@t.Rate.ToString("0.####")%)</td><td style="text-align:right">@t.Amount.ToString("N2")</td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" style="text-align:right">Tax</td><td style="text-align:right">@_order.TaxTotal.ToString("N2")</td></tr>
                }
                <tr><th colspan="4" style="text-align:right">Total (@_order.Currency)</th><th style="text-align:right">@_order.Total.ToString("N2")</th></tr>
            </tfoot>
        </table>
        <p class="pc-muted">Names and prices are copies taken when the order was placed.</p>
    </div>

    <div class="pc-card">
        <h2 style="margin-top:0">Sending</h2>
        <table class="pc-table">
            <thead>
                <tr><th>Product</th><th style="text-align:right">Bought</th><th style="text-align:right">Sent</th><th style="text-align:right">Returned</th>
                    @if (_order.Stage == OrderStage.Processing) { <th style="text-align:right">Send now</th> }</tr>
            </thead>
            <tbody>
            @foreach (var l in _order.Lines)
            {
                var line = l;
                <tr>
                    <td>@l.Name</td>
                    <td style="text-align:right">@l.Quantity</td>
                    <td style="text-align:right">@l.QuantityShipped</td>
                    <td style="text-align:right">@l.QuantityReturned</td>
                    @if (_order.Stage == OrderStage.Processing)
                    {
                        <td style="text-align:right">
                            @if (l.QuantityShipped < l.Quantity)
                            {
                                <input type="number" min="0" max="@(l.Quantity - l.QuantityShipped)" style="width:5em" value="@QtyOf(_sendQty, line.Id)"
                                       @onchange="e => SetQty(_sendQty, line.Id, e.Value?.ToString())" aria-label="Quantity to send" />
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>

        @if (_order.Stage == OrderStage.Placed)
        {
            <p class="pc-muted">Move the order to Processing, then record each parcel here as it leaves.</p>
        }
        else if (_order.Stage == OrderStage.Processing)
        {
            @if (_carriers.Count > 0)
            {
                <label>Carrier
                    <select @bind="_carrierId" aria-label="Carrier">
                        <option value="">Other (type it below)</option>
                        @foreach (var c in _carriers) { <option value="@c.Id">@c.Name</option> }
                    </select>
                </label>
            }
            @if (_carrierId is null)
            {
                <label>Carrier (optional) <input type="text" maxlength="100" @bind="_carrier" /></label>
            }
            <label>Tracking number (optional) <input type="text" maxlength="100" @bind="_trackingNumber" /></label>
            <label>Tracking link (optional, https://...) <input type="text" maxlength="500" @bind="_trackingUrl" /></label>
            <button type="button" disabled="@_busy" @onclick="SendChosenAsync">Send the quantities above</button>
            <button type="button" class="secondary" disabled="@_busy" @onclick="SendAllAsync">Send everything left</button>
            <p class="pc-muted">Sending does not change stock (it was taken when the order was placed). When the last item has gone the order is completed.</p>
            @if (_order.Lines.Any(x => x.QuantityShipped > 0))
            {
                <p class="pc-muted">Part of this order has been sent, so it can no longer be cancelled: record a return for anything that comes back.</p>
            }
        }

        @if (_shipments is { Count: > 0 })
        {
            <table class="pc-table">
                <thead><tr><th>Sent</th><th>What</th><th>Carrier</th><th>Tracking</th><th>By</th></tr></thead>
                <tbody>
                @foreach (var sh in _shipments)
                {
                    <tr>
                        <td>@sh.ShippedUtc.ToString("dd MMM yyyy HH:mm") UTC</td>
                        <td>@string.Join(", ", sh.Lines.Select(x => x.Quantity + " x " + x.Name))</td>
                        <td>@sh.Carrier</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(sh.TrackingUrl)) { <a href="@sh.TrackingUrl" target="_blank" rel="noopener noreferrer">@(sh.TrackingNumber ?? "Track")</a> }
                            else { @sh.TrackingNumber }
                        </td>
                        <td>@sh.Actor</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="pc-card">
        <h2 style="margin-top:0">Returns</h2>
        @if (_requests is { Count: > 0 })
        {
            <h3>Requests from the buyer</h3>
            <table class="pc-table">
                <thead><tr><th>Asked</th><th>What</th><th>Reason</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var rq in _requests)
                {
                    var request = rq;
                    <tr>
                        <td>@rq.RequestedUtc.ToString("dd MMM yyyy HH:mm") UTC</td>
                        <td>@string.Join(", ", rq.Lines.Select(x => x.Quantity + " x " + x.Name))</td>
                        <td>@rq.Reason@(string.IsNullOrWhiteSpace(rq.Note) ? "" : " (" + rq.Note + ")")</td>
                        <td>@rq.Status@(string.IsNullOrWhiteSpace(rq.ResponseNote) ? "" : ": " + rq.ResponseNote)</td>
                        <td class="actions">
                            @if (rq.Status == ReturnRequestStatus.Requested)
                            {
                                <input type="text" maxlength="1000" placeholder="Message to the buyer (optional)" @bind="_answerNote" aria-label="Message to the buyer" />
                                <button type="button" disabled="@_busy" @onclick="() => AnswerAsync(request, true)">Approve</button>
                                <button type="button" class="secondary" disabled="@_busy" @onclick="() => AnswerAsync(request, false)">Turn down</button>
                            }
                            else if (rq.Status == ReturnRequestStatus.Approved)
                            {
                                <button type="button" class="secondary" @onclick="() => UseRequest(request)">Fill in the return from this</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        @if (_returnNotice is not null)
        {
            <p role="status">@_returnNotice</p>
        }
        @if (_order.Lines.Any(x => x.QuantityShipped > x.QuantityReturned))
        {
            <p class="pc-muted">Record goods when they arrive back. This puts the chosen items back on the shelf; it does not refund anything (do that under Payment).</p>
            <table class="pc-table">
                <thead><tr><th>Product</th><th style="text-align:right">Can come back</th><th style="text-align:right">Came back now</th><th>Put back on the shelf</th></tr></thead>
                <tbody>
                @foreach (var l in _order.Lines.Where(x => x.QuantityShipped > x.QuantityReturned))
                {
                    var line = l;
                    <tr>
                        <td>@l.Name</td>
                        <td style="text-align:right">@(l.QuantityShipped - l.QuantityReturned)</td>
                        <td style="text-align:right">
                            <input type="number" min="0" max="@(l.QuantityShipped - l.QuantityReturned)" style="width:5em" value="@QtyOf(_returnQty, line.Id)"
                                   @onchange="e => SetQty(_returnQty, line.Id, e.Value?.ToString())" aria-label="Quantity returned" />
                        </td>
                        <td><input type="checkbox" checked="@(!_noRestock.Contains(line.Id))" @onchange="e => SetRestock(line.Id, e.Value is true)" aria-label="Put back on the shelf" /></td>
                    </tr>
                }
                </tbody>
            </table>
            <label>Reason <input type="text" maxlength="200" @bind="_returnReason" /></label>
            <label>Note (optional) <input type="text" maxlength="1000" @bind="_returnNote" /></label>
            @if (_returns is null || _returns.All(r => !r.ShippingIncluded))
            {
                <label><input type="checkbox" @bind="_returnShipping" /> Include the delivery charge in the suggested refund</label>
            }
            <button type="button" disabled="@_busy" @onclick="RecordReturnAsync">Record return</button>
        }
        else
        {
            <p class="pc-muted">Nothing has been sent that could come back.</p>
        }
        @if (_returns is { Count: > 0 })
        {
            <table class="pc-table">
                <thead><tr><th>When</th><th>What</th><th>Reason</th><th>By</th><th style="text-align:right">Suggested refund</th></tr></thead>
                <tbody>
                @foreach (var r in _returns)
                {
                    <tr>
                        <td>@r.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</td>
                        <td>@string.Join(", ", r.Lines.Select(x => x.Quantity + " x " + x.Name + (x.Restocked ? "" : " (not restocked)")))@(r.ShippingIncluded ? " + delivery" : "")</td>
                        <td>@r.Reason@(string.IsNullOrWhiteSpace(r.Note) ? "" : " (" + r.Note + ")")</td>
                        <td>@r.Actor</td>
                        <td style="text-align:right">@r.SuggestedRefund.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="pc-card">
        <h2 style="margin-top:0">Payment: @_order.PaymentStatus</h2>
        <p>Paid @_order.AmountPaid.ToString("N2") @_order.Currency, refunded @_order.AmountRefunded.ToString("N2"), of @_order.Total.ToString("N2").</p>
        @if (_order.Stage == OrderStage.Cancelled && _order.AmountPaid - _order.AmountRefunded > 0)
        {
            <p class="pc-error">This order is cancelled but @((_order.AmountPaid - _order.AmountRefunded).ToString("N2")) has not been refunded.</p>
        }
        @if (_payments is { Count: > 0 })
        {
            <table class="pc-table">
                <thead><tr><th>When</th><th>Type</th><th>Provider</th><th>Reference</th><th>By</th><th style="text-align:right">Amount</th></tr></thead>
                <tbody>
                @foreach (var p in _payments)
                {
                    <tr>
                        <td>@p.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</td>
                        <td>@p.Kind</td>
                        <td>@p.Provider</td>
                        <td>@p.Reference @(string.IsNullOrWhiteSpace(p.Note) ? "" : "(" + p.Note + ")")</td>
                        <td>@p.Actor</td>
                        <td style="text-align:right">@(p.Kind == PaymentKind.Refund ? "-" : "")@p.Amount.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        @if (_disputes is { Count: > 0 })
        {
            <h3>Disputes with the buyer's bank</h3>
            <p class="pc-muted">Answer an open dispute in the payment provider's own dashboard before its deadline. A lost one is recorded above as a refund.</p>
            <table class="pc-table">
                <thead><tr><th>Opened</th><th>Provider</th><th style="text-align:right">Amount</th><th>Reason</th><th>Answer by</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var d in _disputes)
                {
                    <tr>
                        <td>@d.OpenedUtc.ToString("dd MMM yyyy") UTC</td>
                        <td>@d.Provider @d.Reference</td>
                        <td style="text-align:right">@d.Amount.ToString("N2") @d.Currency</td>
                        <td>@d.Reason</td>
                        <td>@(d.RespondByUtc?.ToString("dd MMM yyyy") ?? "-")</td>
                        <td>@d.Status</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        @if (VoucherReturnable > 0)
        {
            <h3>Return to the gift voucher</h3>
            <p class="pc-muted">
                Part of this order was paid with a gift voucher. This puts money back onto that voucher (up to @VoucherReturnable.ToString("N2") @_order.Currency)
                and records it as a refund. Cancelling the order does this for whatever is left.
            </p>
            <label>Amount <input type="number" step="0.01" min="0.01" @bind="_voucherAmount" /></label>
            <button type="button" class="secondary" disabled="@_busy" @onclick="ReturnToVoucherAsync">Return to gift voucher</button>
        }
        @if (_refundable.Count > 0 && _order.AmountPaid - _order.AmountRefunded > 0)
        {
            <h3>Refund to the buyer's card</h3>
            <p class="pc-muted">
                Sends the money back through the payment provider and records it here. A refund you make in the provider's own dashboard
                is recorded automatically; do not enter it again below.
            </p>
            @if (_refundNotice is not null)
            {
                <p role="status">@_refundNotice</p>
            }
            <label>Payment
                <select @onchange="e => _refundPaymentId = Guid.Parse(e.Value!.ToString()!)">
                    @foreach (var rp in _refundable)
                    {
                        <option value="@rp.Id" selected="@(rp.Id == _refundPaymentId)">@rp.Provider @rp.Reference - @rp.Amount.ToString("N2")</option>
                    }
                </select>
            </label>
            <label>Amount <input type="number" step="0.01" min="0.01" @bind="_refundAmount" /></label>
            <button type="button" disabled="@_busy" @onclick="RefundViaProviderAsync">Refund through provider</button>
            <hr />
            <h3>Record a payment or refund made elsewhere</h3>
        }
        <EditForm Model="_payment" OnValidSubmit="() => RecordAsync(false)" FormName="payment">
            <DataAnnotationsValidator />
            <label>Amount <InputNumber @bind-Value="_payment.Amount" /></label>
            <ValidationMessage For="() => _payment.Amount" />
            <label>Provider
                <InputSelect @bind-Value="_payment.Provider">
                    @foreach (var provider in _providers)
                    {
                        <option value="@provider.Name">@provider.DisplayName</option>
                    }
                </InputSelect>
            </label>
            <label>Reference (receipt or bank reference, optional) <InputText @bind-Value="_payment.Reference" /></label>
            <label>Note (optional) <InputText @bind-Value="_payment.Note" /></label>
            <button type="submit" disabled="@_busy">Record payment</button>
            <button type="button" class="secondary" disabled="@_busy" @onclick="() => RecordAsync(true)">Record refund</button>
        </EditForm>
    </div>

    <div class="pc-card">
        <h2 style="margin-top:0">Addresses</h2>
        <div style="display:flex; gap:2rem; flex-wrap:wrap">
            <AddressBlock Title="Ship to" Address="_order.ShippingAddress" />
            <AddressBlock Title="Billing" Address="_order.BillingAddress" />
        </div>
    </div>

    <p><a href="/admin/orders">Back to orders</a></p>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private OrderDto? _order;
    private bool _notFound;
    private bool _busy;
    private bool _confirmCancel;
    private string? _error;
    private IReadOnlyList<PaymentDto>? _payments;
    private IReadOnlyList<PaymentProviderDto> _providers = [];
    private PaymentInput _payment = new() { Provider = "manual" };
    private IReadOnlyList<ShipmentDto>? _shipments;
    private IReadOnlyList<ReturnDto>? _returns;
    private readonly Dictionary<Guid, int> _sendQty = new();
    private readonly Dictionary<Guid, int> _returnQty = new();
    private readonly HashSet<Guid> _noRestock = new();
    private IReadOnlyList<ShippingCarrierDto> _carriers = [];
    private Guid? _carrierId;
    private string? _carrier, _trackingNumber, _trackingUrl, _returnReason, _returnNote, _returnNotice, _refundNotice;
    private bool _returnShipping;
    private List<PaymentDto> _refundable = [];
    private Guid _refundPaymentId;
    private decimal _refundAmount;
    private string _refundKey = Guid.NewGuid().ToString("N");

    private static int QtyOf(Dictionary<Guid, int> map, Guid id) => map.GetValueOrDefault(id);

    private static void SetQty(Dictionary<Guid, int> map, Guid id, string? text) =>
        map[id] = int.TryParse(text, out var n) && n > 0 ? n : 0;

    private void SetRestock(Guid id, bool on) { if (on) _noRestock.Remove(id); else _noRestock.Add(id); }

    protected override async Task OnParametersSetAsync()
    {
        _order = await Scope.RunAsync<IOrderService, OrderDto?>(s => s.GetAsync(Id));
        _carriers = await Scope.RunAsync<IShippingCarrierService, IReadOnlyList<ShippingCarrierDto>>(s => s.ListAsync(true));
        _notFound = _order is null;
        if (_order is not null) await LoadPaymentsAsync();
    }

    private async Task LoadPaymentsAsync()
    {
        _payments = await Scope.RunAsync<IPaymentService, IReadOnlyList<PaymentDto>?>(s => s.ListAsync(Id));
        _providers = await Scope.RunAsync<IPaymentService, IReadOnlyList<PaymentProviderDto>>(s => Task.FromResult(s.Providers()));
        _shipments = await Scope.RunAsync<IFulfilmentService, IReadOnlyList<ShipmentDto>?>(s => s.ListShipmentsAsync(Id));
        _returns = await Scope.RunAsync<IFulfilmentService, IReadOnlyList<ReturnDto>?>(s => s.ListReturnsAsync(Id));
        _disputes = (await Scope.RunAsync<IDisputeService, IReadOnlyList<PaymentDisputeDto>?>(s => s.ListForOrderAsync(Id)))?.ToList();
        _requests = (await Scope.RunAsync<IReturnRequestService, IReadOnlyList<ReturnRequestDto>?>(s => s.ListForOrderAsync(Id)))?.ToList();
        var refunders = _providers.Where(x => x.CanRefund).Select(x => x.Name).ToHashSet();
        _refundable = (_payments ?? []).Where(x => x.Kind == PaymentKind.Payment && !string.IsNullOrWhiteSpace(x.Reference) && refunders.Contains(x.Provider)).ToList();
        if (_refundable.Count > 0 && !_refundable.Any(x => x.Id == _refundPaymentId)) _refundPaymentId = _refundable[0].Id;
        var owed = _order!.Total - (_order.AmountPaid - _order.AmountRefunded);
        _payment = new PaymentInput { Provider = _payment.Provider ?? "manual", Amount = owed > 0 && _order.Stage != OrderStage.Cancelled ? owed : 0 };
    }

    private decimal _voucherAmount;
    private List<PaymentDisputeDto>? _disputes;

    /// <summary>What the order's gift voucher paid and has not had back yet (and what is still refundable).</summary>
    private decimal VoucherReturnable
    {
        get
        {
            if (_order is null || _payments is null) return 0m;
            var paid = _payments.Where(x => x.Provider == "voucher" && x.Kind == PaymentKind.Payment).Sum(x => x.Amount);
            var back = _payments.Where(x => x.Provider == "voucher" && x.Kind == PaymentKind.Refund).Sum(x => x.Amount);
            return Math.Max(0m, Math.Min(paid - back, _order.AmountPaid - _order.AmountRefunded));
        }
    }

    private async Task ReturnToVoucherAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var actor = await Auth.GetActorAsync();
            var input = new RefundToVoucherInput { Amount = _voucherAmount };
            await Scope.RunAsync<IPaymentService, PaymentDto?>(s => s.RefundToVoucherAsync(Id, input, actor));
            _voucherAmount = 0;
            _order = await Scope.RunAsync<IOrderService, OrderDto?>(s => s.GetAsync(Id)) ?? _order;
            await LoadPaymentsAsync();
        }
        catch (PiranhaValidationException ex) { _error = string.Join(" ", ex.Errors.SelectMany(e => e.Value)); }
        catch (PiranhaConflictException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = "Could not return it: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task RecordAsync(bool refund)
    {
        _busy = true;
        _error = null;
        try
        {
            var actor = await Auth.GetActorAsync();
            var input = _payment;
            if (refund) await Scope.RunAsync<IPaymentService, PaymentDto?>(s => s.RecordRefundAsync(Id, input, actor));
            else await Scope.RunAsync<IPaymentService, PaymentDto?>(s => s.RecordPaymentAsync(Id, input, actor));
            _order = await Scope.RunAsync<IOrderService, OrderDto?>(s => s.GetAsync(Id)) ?? _order;
            await LoadPaymentsAsync();
        }
        catch (PiranhaValidationException ex) { _error = string.Join(" ", ex.Errors.SelectMany(e => e.Value)); }
        catch (PiranhaConflictException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = "Could not record that: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task ReloadAsync()
    {
        _order = await Scope.RunAsync<IOrderService, OrderDto?>(s => s.GetAsync(Id)) ?? _order;
        await LoadPaymentsAsync();
    }

    private async Task SendAsync(ShipmentInput input)
    {
        _busy = true; _error = null;
        try
        {
            var actor = await Auth.GetActorAsync();
            await Scope.RunAsync<IFulfilmentService, ShipmentDto?>(s => s.ShipAsync(Id, input, actor));
            _sendQty.Clear(); _carrier = _trackingNumber = _trackingUrl = null; _carrierId = null;
        }
        catch (PiranhaValidationException ex) { _error = string.Join(" ", ex.Errors.SelectMany(e => e.Value)); }
        catch (PiranhaConflictException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = "Could not record that: " + ex.Message; }
        finally { _busy = false; }
        await ReloadAsync();
    }

    private Task SendAllAsync() => SendAsync(new ShipmentInput { CarrierId = _carrierId, Carrier = _carrier, TrackingNumber = _trackingNumber, TrackingUrl = _trackingUrl });

    private Task SendChosenAsync()
    {
        var lines = _sendQty.Where(kv => kv.Value > 0).Select(kv => new FulfilmentLineInput { OrderLineId = kv.Key, Quantity = kv.Value }).ToList();
        if (lines.Count == 0) { _error = "Enter how many of each item are in this parcel, or send everything left."; return Task.CompletedTask; }
        return SendAsync(new ShipmentInput { Lines = lines, CarrierId = _carrierId, Carrier = _carrier, TrackingNumber = _trackingNumber, TrackingUrl = _trackingUrl });
    }

    private List<ReturnRequestDto>? _requests;
    private string? _answerNote;
    private Guid? _returnRequestId;

    private async Task AnswerAsync(ReturnRequestDto request, bool approve)
    {
        _busy = true; _error = null;
        try
        {
            var actor = await Auth.GetActorAsync();
            var input = new ReturnResponseInput { Note = _answerNote };
            var id = request.Id;
            if (approve) await Scope.RunAsync<IReturnRequestService, ReturnRequestDto?>(s => s.ApproveAsync(id, input, actor));
            else await Scope.RunAsync<IReturnRequestService, ReturnRequestDto?>(s => s.RejectAsync(id, input, actor));
            _answerNote = null;
            await LoadPaymentsAsync();
        }
        catch (PiranhaValidationException ex) { _error = string.Join(" ", ex.Errors.SelectMany(e => e.Value)); }
        catch (PiranhaConflictException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = "Could not answer that: " + ex.Message; }
        finally { _busy = false; }
    }

    /// <summary>Copies an approved request into the return form below; recording it then closes the request.</summary>
    private void UseRequest(ReturnRequestDto request)
    {
        _returnQty.Clear();
        foreach (var l in request.Lines) _returnQty[l.OrderLineId] = l.Quantity;
        _returnReason = request.Reason;
        _returnRequestId = request.Id;
    }

    private async Task RecordReturnAsync()
    {
        _busy = true; _error = null; _returnNotice = null;
        try
        {
            var lines = _returnQty.Where(kv => kv.Value > 0)
                .Select(kv => new ReturnLineInput { OrderLineId = kv.Key, Quantity = kv.Value, Restock = !_noRestock.Contains(kv.Key) }).ToList();
            var input = new ReturnInput { Reason = _returnReason ?? "", Note = _returnNote, IncludeShipping = _returnShipping, ReturnRequestId = _returnRequestId, Lines = lines };
            var actor = await Auth.GetActorAsync();
            var saved = await Scope.RunAsync<IFulfilmentService, ReturnDto?>(s => s.RecordReturnAsync(Id, input, actor));
            if (saved is not null)
            {
                _returnNotice = $"Return recorded. Suggested refund: {saved.SuggestedRefund:N2} {_order!.Currency}.";
                _refundAmount = saved.SuggestedRefund;
                _returnQty.Clear(); _noRestock.Clear(); _returnReason = _returnNote = null; _returnShipping = false; _returnRequestId = null;
            }
        }
        catch (PiranhaValidationException ex) { _error = string.Join(" ", ex.Errors.SelectMany(e => e.Value)); }
        catch (PiranhaConflictException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = "Could not record that: " + ex.Message; }
        finally { _busy = false; }
        var suggested = _refundAmount;
        await ReloadAsync();
        _refundAmount = suggested;
    }

    private async Task RefundViaProviderAsync()
    {
        _busy = true; _error = null; _refundNotice = null;
        try
        {
            var input = new RefundStartInput { Amount = _refundAmount, IdempotencyKey = _refundKey };
            var paymentId = _refundPaymentId;
            var actor = await Auth.GetActorAsync();
            var result = await Scope.RunAsync<IGatewayService, RefundResultDto?>(s => s.RefundAsync(Id, paymentId, input, actor));
            if (result is not null)
            {
                _refundNotice = result.Outcome switch
                {
                    "Pending" => "The provider is still processing this refund. It will be recorded here when it completes.",
                    "Unreconciled" => "The provider refunded it but it could not be recorded here. See Unreconciled payments.",
                    _ => "Refunded " + result.Amount.ToString("N2") + " " + result.Currency + ".",
                };
                _refundKey = Guid.NewGuid().ToString("N"); // the next refund is a new one; a repeat click above reused the key
                _refundAmount = 0;
            }
        }
        catch (PiranhaValidationException ex) { _error = string.Join(" ", ex.Errors.SelectMany(e => e.Value)); }
        catch (PiranhaConflictException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = "Could not refund: " + ex.Message; }
        finally { _busy = false; }
        var kept = _refundAmount;
        await ReloadAsync();
        _refundAmount = kept;
    }

    private async Task MoveAsync(OrderStage to)
    {
        _busy = true;
        _error = null;
        _confirmCancel = false;
        try
        {
            var actor = await Auth.GetActorAsync();
            var updated = await Scope.RunAsync<IOrderService, OrderDto?>(s => s.ChangeStageAsync(Id, to, actor));
            if (updated is null) _notFound = true; else { _order = updated; await LoadPaymentsAsync(); }
        }
        catch (PiranhaConflictException ex)
        {
            _error = ex.Message;
            _order = await Scope.RunAsync<IOrderService, OrderDto?>(s => s.GetAsync(Id)) ?? _order; // show what it is now
        }
        catch (Exception ex)
        {
            _error = "Could not update the order: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
