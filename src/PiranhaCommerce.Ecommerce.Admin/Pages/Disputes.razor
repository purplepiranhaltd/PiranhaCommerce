@page "/admin/orders/disputes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = PiranhaCommerce.Core.Identity.PermissionPolicies.OrdersView)]
@using PiranhaCommerce.Core.Paging
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@inject AdminScopeRunner Scope
@inject IJSRuntime Js
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Auth
@inject IOptions<DisputeFileOptions> FileOptions

<PageTitle>Disputes - PiranhaCommerce</PageTitle>
<h1>Disputes</h1>
<p class="pc-muted">
    A buyer disputed a card payment with their bank. Answer an open dispute before its deadline: where the provider allows it you can send evidence from here
    (save it first if you like, then send it: sending is final), otherwise use the provider's own dashboard. Winning moves no money; a lost dispute is recorded
    as a refund on the order. The fee is what the provider charged you for the dispute.
</p>

@if (_error is not null)
{
    <p class="pc-error" role="alert">@_error</p>
}

<label><input type="checkbox" checked="@_openOnly" @onchange="ToggleAsync" /> Open ones only</label>

@if (_items is null)
{
    <p class="pc-muted">Loading...</p>
}
else if (_items.Items.Count == 0)
{
    <p class="pc-muted">@(_openOnly ? "No open disputes." : "No disputes.")</p>
}
else
{
    <table class="pc-table">
        <thead><tr><th>Opened</th><th>Order</th><th>Provider</th><th style="text-align:right">Amount</th><th>Reason</th><th style="text-align:right">Fee</th><th>Answer by</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in _items.Items)
        {
            <tr>
                <td>@d.OpenedUtc.ToString("dd MMM yyyy")</td>
                <td><a href="/admin/orders/@d.OrderId">@d.OrderReference</a></td>
                <td>@d.Provider<br /><span class="pc-muted">@d.Reference</span></td>
                <td style="text-align:right">@d.Amount.ToString("N2") @d.Currency</td>
                <td>@d.Reason</td>
                <td style="text-align:right">@(d.Fee is null ? "-" : d.Fee.Value.ToString("N2"))</td>
                <td>@(d.RespondByUtc?.ToString("dd MMM yyyy") ?? "-")</td>
                <td>@d.Status@(d.EvidenceSubmittedUtc is not null ? " (evidence sent)" : "")</td>
                <td>@if (d.Status == DisputeStatus.Open && d.EvidenceSubmittedUtc is null) { <PiranhaCommerce.Admin.Components.Can Permission="orders.refund"><button type="button" class="secondary" @onclick="() => Open(d)">Evidence</button></PiranhaCommerce.Admin.Components.Can> }</td>
            </tr>
            @if (_editing == d.Id)
            {
                <tr><td colspan="9">
                    <div class="pc-card">
                        <label>What was sold <textarea rows="2" @bind="_form.ProductDescription"></textarea></label>
                        <label>Customer name <input @bind="_form.CustomerName" /></label>
                        <label>Customer email <input @bind="_form.CustomerEmail" /></label>
                        <label>Shipping address <input @bind="_form.ShippingAddress" /></label>
                        <label>Carrier <input @bind="_form.ShippingCarrier" /></label>
                        <label>Tracking number <input @bind="_form.TrackingNumber" /></label>
                        <label>Shipped on <input type="date" @bind="_form.ShippingDate" /></label>
                        <label>Anything else that shows they received it <textarea rows="3" @bind="_form.Notes"></textarea></label>

                        <h3>Documents</h3>
                        <p class="pc-muted">A receipt, proof of delivery, emails with the buyer and so on: PDF, JPEG or PNG, one for each kind, up to @(FileOptions.Value.MaxBytes / (1024 * 1024)) MB each
                            and @(FileOptions.Value.MaxTotalBytes / 1_000_000.0) MB in all. They are added at once and go to the provider when you save or send.</p>
                        @if (_files.Count > 0)
                        {
                            <ul>
                            @foreach (var f in _files)
                            {
                                <li>
                                    @f.Kind: <button type="button" class="link" @onclick="() => DownloadAsync(d, f)">@f.FileName</button>
                                    <span class="pc-muted">(@((f.Length / 1024.0).ToString("N0")) KB)</span>
                                    <PiranhaCommerce.Admin.Components.Can Permission="orders.refund"><button type="button" class="secondary" disabled="@_busy" @onclick="() => RemoveFileAsync(d, f)">Remove</button></PiranhaCommerce.Admin.Components.Can>
                                </li>
                            }
                            </ul>
                        }
                        <label>This is
                            <select @bind="_kind">
                                @foreach (var k in Enum.GetValues<DisputeEvidenceKind>()) { <option value="@k">@k</option> }
                            </select>
                        </label>
                        <InputFile OnChange="e => UploadAsync(d, e)" accept="application/pdf,image/jpeg,image/png" disabled="@_busy" />
                        <PiranhaCommerce.Admin.Components.Can Permission="orders.refund"><button type="button" class="secondary" disabled="@_busy" @onclick="() => SendAsync(d, false)">Save only</button></PiranhaCommerce.Admin.Components.Can>
                        <PiranhaCommerce.Admin.Components.Can Permission="orders.refund"><button type="button" disabled="@_busy" @onclick="() => SendAsync(d, true)">Send to the bank (final)</button></PiranhaCommerce.Admin.Components.Can>
                        <button type="button" class="secondary" @onclick="() => _editing = null">Close</button>
                        @if (_message is not null) { <p role="status">@_message</p> }
                    </div>
                </td></tr>
            }
        }
        </tbody>
    </table>
}

@code {
    private PagedResult<PaymentDisputeDto>? _items;
    private bool _openOnly = true;
    private string? _error, _message;
    private Guid? _editing;
    private bool _busy;
    private DisputeEvidenceInput _form = new();

    private IReadOnlyList<DisputeFileDto> _files = [];
    private DisputeEvidenceKind _kind = DisputeEvidenceKind.Receipt;

    private async Task Open(PaymentDisputeDto d)
    {
        _editing = d.Id; _form = new(); _message = null;
        await LoadFilesAsync(d.Id);
    }

    private async Task LoadFilesAsync(Guid id) =>
        _files = await Scope.RunAsync<IDisputeService, IReadOnlyList<DisputeFileDto>?>(s => s.ListFilesAsync(id)) ?? [];

    private async Task UploadAsync(PaymentDisputeDto d, InputFileChangeEventArgs e)
    {
        _busy = true; _message = null;
        try
        {
            var id = d.Id; var kind = _kind; var name = e.File.Name; var actor = await Auth.GetActorAsync();
            // Read through a stream that stops one byte over the limit, so a huge file is never held whole.
            await using var stream = e.File.OpenReadStream(FileOptions.Value.MaxBytes + 1);
            await Scope.RunAsync<IDisputeService, DisputeFileDto?>(s => s.AddFileAsync(id, kind, stream, name, actor));
            await LoadFilesAsync(id);
            _message = "Document added.";
        }
        catch (PiranhaCommerce.Core.Validation.PiranhaCommerceValidationException ex) { _message = string.Join(" ", ex.Errors.SelectMany(x => x.Value)); }
        catch (IOException) { _message = "That file is too big."; }
        catch (Exception ex) { _message = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RemoveFileAsync(PaymentDisputeDto d, DisputeFileDto f)
    {
        _busy = true; _message = null;
        try
        {
            var id = d.Id; var fileId = f.Id;
            await Scope.RunAsync<IDisputeService, bool>(s => s.DeleteFileAsync(id, fileId));
            await LoadFilesAsync(id);
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DownloadAsync(PaymentDisputeDto d, DisputeFileDto f)
    {
        try
        {
            var id = d.Id; var fileId = f.Id;
            var download = await Scope.RunAsync<IDisputeService, DisputeFileDownload?>(s => s.OpenFileAsync(id, fileId));
            if (download is null) { _message = "The file is missing."; return; }
            using var reference = new DotNetStreamReference(download.Content);
            await Js.InvokeVoidAsync("piranhaDownload", download.FileName, download.ContentType, reference);
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private async Task SendAsync(PaymentDisputeDto d, bool submit)
    {
        _busy = true; _message = null;
        try
        {
            _form.Submit = submit;
            var input = _form; var id = d.Id;
            await Scope.RunAsync<IDisputeService, PaymentDisputeDto?>(s => s.SubmitEvidenceAsync(id, input));
            if (submit) _editing = null;
            else _message = "Saved at the provider. You can still change it.";
            await LoadAsync();
        }
        catch (PiranhaCommerce.Core.Validation.PiranhaCommerceValidationException ex) { _message = string.Join(" ", ex.Errors.SelectMany(x => x.Value)); }
        catch (Exception ex) { _message = ex.Message; }
        finally { _busy = false; }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task ToggleAsync(ChangeEventArgs e) { _openOnly = e.Value is true; return LoadAsync(); }

    private async Task LoadAsync()
    {
        try
        {
            DisputeStatus? status = _openOnly ? DisputeStatus.Open : null;
            _items = await Scope.RunAsync<IDisputeService, PagedResult<PaymentDisputeDto>>(s => s.ListAsync(status, 1, 100));
        }
        catch (Exception ex) { _error = "Could not load disputes: " + ex.Message; }
    }
}
