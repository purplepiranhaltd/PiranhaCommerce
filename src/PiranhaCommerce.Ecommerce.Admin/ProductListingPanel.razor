@* Panel for AdminSlots.ProductEditPanels; the slot supplies ProductId. Saves independently of the product form. *@
<div class="pc-card" style="margin-top:1rem">
    <h2 style="margin-top:0">Online store</h2>
    @if (_loading)
    {
        <p class="pc-muted">Loading...</p>
    }
    else if (_listing is null)
    {
        <p class="pc-error">Could not load the online listing for this product.</p>
    }
    else
    {
        <label>
            <InputCheckbox @bind-Value="_published" /> Published on the online store
        </label>
        <label>Tax class
            <InputSelect @bind-Value="_taxClassId">
                <option value="">Default class</option>
                @foreach (var c in _classes)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </InputSelect>
        </label>
        <button type="button" @onclick="SaveAsync" disabled="@_saving">Save online settings</button>
        @if (_message is not null)
        {
            <span class="pc-muted" role="status"> @_message</span>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid ProductId { get; set; }
    [Inject] private AdminScopeRunner Scope { get; set; } = default!;

    private ProductListingDto? _listing;
    private IReadOnlyList<TaxClassDto> _classes = [];
    private Guid? _taxClassId;
    private bool _published, _loading = true, _saving;
    private string? _message;
    private Guid _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ProductId) return;
        _loadedFor = ProductId;
        _loading = true;
        _message = null;
        _listing = await Scope.RunAsync<IProductListingService, ProductListingDto?>(s => s.GetAsync(ProductId));
        _published = _listing?.Published ?? false;
        _taxClassId = _listing?.TaxClassId;
        _classes = await Scope.RunAsync<ITaxService, IReadOnlyList<TaxClassDto>>(s => s.ListClassesAsync());
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            _listing = await Scope.RunAsync<IProductListingService, ProductListingDto?>(
                s => s.SetAsync(ProductId, new ProductListingInput { Published = _published, TaxClassId = _taxClassId }));
            _message = _listing is null ? "Product no longer exists." : "Saved.";
        }
        finally { _saving = false; }
    }
}
