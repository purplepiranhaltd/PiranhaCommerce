@inject AdminScopeRunner Scope
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Auth

<div class="pc-card">
    <h2 style="margin-top:0">Sign-in</h2>

    @if (_error is not null)
    {
        <p class="pc-error" role="alert">@_error</p>
    }
    @if (_notice is not null)
    {
        <p role="status">@_notice</p>
    }

    @if (_status is null)
    {
        <p class="pc-muted">Loading...</p>
    }
    else
    {
        <p>
            <strong>@Describe(_status.State)</strong>
            @if (_status.HasSignIn)
            {
                <span class="pc-muted"> Password last set @_status.PasswordChangedUtc?.ToString("d MMM yyyy HH:mm") UTC.</span>
            }
        </p>
        @if (_status.HasSignIn)
        {
            <p>Email address: <strong>@(_status.EmailVerifiedUtc is null ? "not verified" : "verified")</strong>
                @if (_status.EmailVerifiedUtc is null)
                {
                    <PiranhaCommerce.Admin.Components.Can Permission="customers.manage"><button type="button" class="secondary" disabled="@_busy" @onclick="VerifyAsync">Mark as verified</button></PiranhaCommerce.Admin.Components.Can>
                }
            </p>
        }
        @if (_status.HasSignIn)
        {
            <p>Two-factor sign-in: <strong>@(_status.TwoFactorEnabled ? "on" : "off")</strong>
                @if (_status.TwoFactorEnabled)
                {
                    @if (_confirmTwoFactor)
                    {
                        <PiranhaCommerce.Admin.Components.Can Permission="customers.manage"><button type="button" class="danger" disabled="@_busy" @onclick="ResetTwoFactorAsync">Confirm: turn off two-factor</button></PiranhaCommerce.Admin.Components.Can>
                        <button type="button" class="secondary" @onclick="() => _confirmTwoFactor = false">Cancel</button>
                        <span class="pc-muted"> Only do this once you are sure who you are speaking to. They can set it up again.</span>
                    }
                    else
                    {
                        <PiranhaCommerce.Admin.Components.Can Permission="customers.manage"><button type="button" class="secondary" disabled="@_busy" @onclick="() => _confirmTwoFactor = true">Turn off two-factor</button></PiranhaCommerce.Admin.Components.Can>
                    }
                }
            </p>
        }
        <p class="pc-muted">
            To switch a customer off, untick Active above and save: that also ends their live sessions straight away.
            Orders and addresses are never affected by anything here.
        </p>

        <div class="pc-toolbar">
            @if (_status.State == SignInState.Locked)
            {
                <PiranhaCommerce.Admin.Components.Can Permission="customers.manage"><button type="button" class="secondary" disabled="@_busy" @onclick="UnlockAsync">Unlock</button></PiranhaCommerce.Admin.Components.Can>
            }
            <button type="button" class="secondary" disabled="@(_busy || !_status.CustomerActive)" @onclick="SendLinkAsync">
                @(_status.HasSignIn ? "Send password reset link" : "Send invitation")
            </button>
            @if (_status.HasSignIn)
            {
                <PiranhaCommerce.Admin.Components.Can Permission="customers.manage"><button type="button" class="secondary" disabled="@_busy" @onclick="SignOutAsync">Sign out everywhere</button></PiranhaCommerce.Admin.Components.Can>
                @if (_confirmRemove)
                {
                    <PiranhaCommerce.Admin.Components.Can Permission="customers.manage"><button type="button" class="danger" disabled="@_busy" @onclick="RemoveAsync">Confirm: remove sign-in</button></PiranhaCommerce.Admin.Components.Can>
                    <button type="button" class="secondary" @onclick="() => _confirmRemove = false">Cancel</button>
                }
                else
                {
                    <PiranhaCommerce.Admin.Components.Can Permission="customers.manage"><button type="button" class="secondary" disabled="@_busy" @onclick="() => _confirmRemove = true">Remove sign-in</button></PiranhaCommerce.Admin.Components.Can>
                }
            }
        </div>
        @if (_history.Count > 0)
        {
            <h3>History</h3>
            <table class="pc-table">
                <thead><tr><th>When (UTC)</th><th>Who</th><th>What</th></tr></thead>
                <tbody>
                @foreach (var e in _history)
                {
                    <tr><td>@e.OccurredUtc.ToString("d MMM yyyy HH:mm")</td><td>@(e.Actor ?? "unknown")</td><td>@e.Action@(e.Detail is null ? "" : " (" + e.Detail + ")")</td></tr>
                }
                </tbody>
            </table>
        }
        @if (!_status.HasSignIn)
        {
            <p class="pc-muted">This customer has no sign-in. The invitation emails them a link to choose a password, which creates one.</p>
        }
    }
</div>

@code {
    [Parameter] public Guid CustomerId { get; set; }

    private CustomerSignInDto? _status;
    private IReadOnlyList<SignInEventDto> _history = [];
    private string? _error, _notice;
    private bool _busy, _confirmRemove;

    protected override Task OnInitializedAsync() => LoadAsync();

    private static string Describe(SignInState state) => state switch
    {
        SignInState.None => "No sign-in.",
        SignInState.Active => "Can sign in.",
        SignInState.Locked => "Locked after too many wrong passwords.",
        SignInState.Disabled => "Switched off: cannot sign in.",
        _ => "",
    };

    private async Task LoadAsync()
    {
        try
        {
            var id = CustomerId;
            _status = await Scope.RunAsync<ICustomerSignInAdminService, CustomerSignInDto?>(s => s.GetAsync(id));
            if (_status is null) _error = "That customer no longer exists.";
            else _history = await Scope.RunAsync<ICustomerSignInAdminService, IReadOnlyList<SignInEventDto>?>(s => s.HistoryAsync(id, 20)) ?? [];
        }
        catch (Exception ex) { _error = "Could not load: " + ex.Message; }
    }

    private async Task RunAsync(Func<ICustomerSignInAdminService, Task<string>> action)
    {
        _busy = true; _error = null; _notice = null; _confirmRemove = false;
        try { _notice = await Scope.RunAsync<ICustomerSignInAdminService, string>(action); }
        catch (Exception ex) { _error = "Could not do that: " + ex.Message; }
        finally { _busy = false; }
        await LoadAsync();
    }

    private async Task VerifyAsync() { var id = CustomerId; var who = await ActorAsync(); await RunAsync(async s => await s.MarkEmailVerifiedAsync(id, who) ? "Marked as verified." : "Already verified, or no sign-in."); }

    private async Task<string?> ActorAsync() => await Auth.GetActorAsync();

    private async Task UnlockAsync() { var id = CustomerId; var who = await ActorAsync(); await RunAsync(async s => await s.UnlockAsync(id, who) ? "Unlocked." : "They have no sign-in."); }

    private async Task SignOutAsync() { var id = CustomerId; var who = await ActorAsync(); await RunAsync(async s => await s.SignOutEverywhereAsync(id, who) ? "Signed out everywhere. They can sign in again." : "They have no sign-in."); }

    private bool _confirmTwoFactor;

    private async Task ResetTwoFactorAsync() { var id = CustomerId; var who = await ActorAsync(); _confirmTwoFactor = false; await RunAsync(async s => await s.ResetTwoFactorAsync(id, who) ? "Two-factor turned off. They can set it up again." : "It was not on."); }

    private async Task RemoveAsync() { var id = CustomerId; var who = await ActorAsync(); await RunAsync(async s => await s.RemoveAsync(id, who) ? "Sign-in removed." : "They had no sign-in."); }

    private async Task SendLinkAsync()
    {
        var id = CustomerId;
        var who = await ActorAsync();
        await RunAsync(async s => await s.SendResetLinkAsync(id, who) switch
        {
            ResetLinkOutcome.Sent => "Email sent.",
            ResetLinkOutcome.Inactive => "Not sent: the customer is switched off.",
            ResetLinkOutcome.RateLimited => "Not sent: too many links were sent to them in the last hour. Try again later.",
            ResetLinkOutcome.SendFailed => "Not sent: the email could not be delivered. Check the email settings.",
            _ => "That customer no longer exists.",
        });
    }
}
