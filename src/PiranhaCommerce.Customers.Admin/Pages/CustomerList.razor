@page "/admin/customers"
@using PiranhaCommerce.Core.Paging
@inject AdminScopeRunner Scope

<PageTitle>Customers - PiranhaCommerce</PageTitle>
<h1>Customers</h1>

<div class="pc-toolbar">
    <input type="search" placeholder="Search name, email or phone" @bind="_search" @bind:event="oninput"
           @onkeydown="OnSearchKey" aria-label="Search customers" />
    <button class="secondary" @onclick="SearchAsync">Search</button>
    <span class="pc-spacer"></span>
    <a class="pc-button" href="/admin/customers/new">New customer</a>
</div>

@if (_error is not null)
{
    <p class="pc-error" role="alert">@_error</p>
}

@if (_result is null)
{
    <p class="pc-muted">Loading...</p>
}
else if (_result.Items.Count == 0)
{
    <p class="pc-muted">No customers found.</p>
}
else
{
    <table class="pc-table">
        <thead>
            <tr><th>Name</th><th>Email</th><th>Phone</th><th>Active</th><th>Sign-in</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var c in _result.Items)
        {
            <tr>
                <td><a href="/admin/customers/@c.Id">@c.DisplayName</a></td>
                <td>@c.Email</td>
                <td>@c.Phone</td>
                <td>@(c.Active ? "Yes" : "No")</td>
                <td>@(_states.TryGetValue(c.Id, out var st) ? st.ToString() : "")</td>
                <td class="actions">
                    @if (_confirmDelete == c.Id)
                    {
                        <button class="danger" @onclick="() => DeleteAsync(c.Id)">Confirm delete</button>
                        <button class="secondary" @onclick="() => _confirmDelete = null">Cancel</button>
                    }
                    else
                    {
                        <button class="secondary" @onclick="() => _confirmDelete = c.Id">Delete</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="pc-pager">
        <button class="secondary" disabled="@(_result.Page <= 1)" @onclick="() => GoToAsync(_result.Page - 1)">Previous</button>
        <span>Page @_result.Page of @Math.Max(_result.TotalPages, 1) (@_result.TotalCount customers)</span>
        <button class="secondary" disabled="@(_result.Page >= _result.TotalPages)" @onclick="() => GoToAsync(_result.Page + 1)">Next</button>
    </div>
}

@code {
    private PagedResult<CustomerDto>? _result;
    private string? _search;
    private string? _error;
    private Guid? _confirmDelete;
    private IReadOnlyDictionary<Guid, SignInState> _states = new Dictionary<Guid, SignInState>();
    private int _page = 1;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            _result = await Scope.RunAsync<ICustomerService, PagedResult<CustomerDto>>(s => s.ListAsync(_page, null, _search));
            var ids = _result.Items.Select(c => c.Id).ToList();
            _states = await Scope.RunAsync<ICustomerSignInAdminService, IReadOnlyDictionary<Guid, SignInState>>(s => s.GetStatesAsync(ids));
        }
        catch (Exception ex)
        {
            _error = "Could not load customers: " + ex.Message;
        }
    }

    private Task SearchAsync() { _page = 1; return LoadAsync(); }

    private Task OnSearchKey(KeyboardEventArgs e) => e.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private Task GoToAsync(int page) { _page = page; return LoadAsync(); }

    private async Task DeleteAsync(Guid id)
    {
        _confirmDelete = null;
        _error = null;
        try
        {
            await Scope.RunAsync<ICustomerService, bool>(s => s.DeleteAsync(id));
            if (_result is { Items.Count: 1 } && _page > 1) _page--;
        }
        catch (PiranhaCommerceConflictException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = "Could not delete: " + ex.Message; }
        await LoadAsync();
    }
}
