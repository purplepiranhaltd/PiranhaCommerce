@inherits LayoutComponentBase
@inject IOptions<SiteOptions> Options

<header class="site-header">
    <div class="container bar">
        <a class="brand" href="@HomeHref" aria-label="PiranhaCommerce"><img src="logo-mark.svg" alt="" width="60" height="30" /><span><span class="w1">Piranha</span><span class="w2">Commerce</span></span></a>
        <nav aria-label="Main">
            @if (!OnDocsHost) { <a href="/#features">Features</a><a href="/#sample">Sample shop</a> }
            <a href="@Links.Docs(Context)">Docs</a>
            @if (!string.IsNullOrWhiteSpace(Options.Value.DemoUrl)) { <a href="@Options.Value.DemoUrl">Demo shop</a> }
        </nav>
    </div>
</header>

<main>@Body</main>

<footer class="site-footer">
    <div class="container">
        <p>PiranhaCommerce is a commerce engine for .NET, delivered as NuGet packages. Currently in alpha.</p>
        <p>&copy; Purple Piranha</p>
    </div>
</footer>

@code {
    [CascadingParameter] private HttpContext? Context { get; set; }

    private bool OnDocsHost => Context is not null && SiteHost.IsDocsHost(Context.Request.Host.Host);

    private string HomeHref => OnDocsHost && !string.IsNullOrWhiteSpace(Options.Value.HomeUrl) ? Options.Value.HomeUrl! : "/";
}
