@page "/"
@inject IOptions<SiteOptions> Options

<PageTitle>Piranha Commerce - commerce for .NET</PageTitle>
<HeadContent><meta name="description" content="Piranha Commerce is a commerce engine for .NET, delivered as NuGet packages: catalogue, checkout, orders, payments, shipping, tax, customers, an admin and a full API." /></HeadContent>

<section class="hero">
    <div class="container">
        <p class="eyebrow">Alpha</p>
        <h1>Commerce for .NET, delivered as packages.</h1>
        <p class="lead">Add a catalogue, baskets, checkout, orders, payments, shipping, tax and customers to your own ASP.NET application. You keep the shop front, the hosting and the database.</p>
        <p class="actions">
            <a class="button" href="@(Links.Docs(Context) + "/getting-started/installation")">Get started</a>
            <a class="button secondary" href="@Links.Docs(Context)">Read the docs</a>
            @if (!string.IsNullOrWhiteSpace(Options.Value.DemoUrl)) { <a class="button secondary" href="@Options.Value.DemoUrl">See the demo shop</a> }
        </p>
    </div>
</section>

<section class="container" id="features">
    <h2>Everything a shop needs, as parts you choose</h2>
    <div class="grid">
        <article class="card"><h3>Catalogue</h3><p>Products, categories, barcodes, pictures, options and variants (shade, size, colour), and stock across several locations with a full ledger.</p></article>
        <article class="card"><h3>Checkout and orders</h3><p>Guest and signed-in baskets, one-transaction checkout, order stages, parcels, returns and refunds, with confirmation and update emails.</p></article>
        <article class="card"><h3>Prices that stack sensibly</h3><p>Sales, customer-group prices, quantity breaks, promo codes and a discount engine, always charging the lowest price that applies.</p></article>
        <article class="card"><h3>Shipping and tax</h3><p>Rates by country, postcode zone and weight, carriers with tracking links, and tax worked out per line by class and destination.</p></article>
        <article class="card"><h3>Payments</h3><p>A gateway plug-in point with Stripe included, gift vouchers, refunds through the provider, disputes and an unreconciled-payments list so no money is lost.</p></article>
        <article class="card"><h3>Customers and privacy</h3><p>Separate shopper sign-in, groups, verified email, and data export and erasure for staff and for shoppers themselves.</p></article>
        <article class="card"><h3>Reviews and engagement</h3><p>Moderated product reviews, wishlists, back-in-stock emails and related or cross-sell suggestions.</p></article>
        <article class="card"><h3>Admin and API</h3><p>A Blazor admin for staff and a documented REST API with a separate storefront API for shoppers, plus signed webhooks and an audit log.</p></article>
    </div>
</section>

<section class="container split">
    <div>
        <h2>Built for .NET developers</h2>
        <p>Piranha Commerce is a set of NuGet packages you register in <code>Program.cs</code>. Plugins are compiled in, there is no runtime scanning, and your host owns the database migrations, so you always know what is running and what it does to your schema.</p>
        <ul class="ticks">
            <li>SQL Server, Azure SQL and PostgreSQL</li>
            <li>Local disk or Azure Blob for pictures</li>
            <li>Optional packages stay optional</li>
            <li>Write your own plugin with tables, endpoints and admin pages</li>
        </ul>
    </div>
    <pre class="code"><code>builder.Services.AddPiranhaCore()
    .AddPiranhaSqlServer(connectionString, typeof(Program).Assembly)
    .AddPiranhaApi()
    .AddPiranhaAdmin()
    .AddPlugin&lt;EcommercePlugin&gt;()
    .AddPlugin&lt;EcommerceAdminPlugin&gt;();</code></pre>
</section>

<section class="container cta">
    <h2>Start with the sample shop</h2>
    <p>The repository includes a complete example shop front, built on the same API you would use. Run it, read how it is put together, then make it yours.</p>
    <p class="actions"><a class="button" href="@(Links.Docs(Context) + "/getting-started/installation")">Installation</a> <a class="button secondary" href="@(Links.Docs(Context) + "/getting-started/first-store")">Your first store</a></p>
</section>

@code {
    [CascadingParameter] private HttpContext? Context { get; set; }
}
